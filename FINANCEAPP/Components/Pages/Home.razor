@page "/"
@using FINANCEAPP.Services
@inject IDashboardService DashboardService

<PageTitle>Inicio</PageTitle>

<section class="home-hero">
    <AppLogo Variant="hero" />
    <p class="eyebrow">Patrimonio total</p>
    <p class="home-balance">@CurrencyFormatter.Format(totalPatrimony, currencyCode)</p>
    <a class="btn btn-primary" href="dashboard">Ver el patrimonio completo</a>
</section>

<h2 class="section-title">Módulos</h2>

<div class="module-grid">
    <a class="module" href="dashboard" style="--swatch:var(--indigo-deep)">
        <span class="module-name">Dashboard</span>
        <span class="module-desc">Patrimonio total, rendimiento, flujo de caja y alertas.</span>
    </a>
    <a class="module" href="companies" style="--swatch:var(--indigo)">
        <span class="module-name">Empresas</span>
        <span class="module-desc">Acciones con precio en vivo y gráfico de cotización.</span>
    </a>
    <a class="module" href="fondos" style="--swatch:var(--teal)">
        <span class="module-name">Fondos de Inversión</span>
        <span class="module-desc">Aportaciones, reembolsos e historial de valores.</span>
    </a>
    <a class="module" href="activos-refugio" style="--swatch:var(--amber)">
        <span class="module-name">Activos Refugio</span>
        <span class="module-desc">Compras y ventas, con total invertido y valor actual.</span>
    </a>
    <a class="module" href="inmuebles" style="--swatch:var(--plum)">
        <span class="module-name">Propiedades</span>
        <span class="module-desc">Ingresos, gastos y venta de inmuebles.</span>
    </a>
    <a class="module" href="banco" style="--swatch:var(--sage)">
        <span class="module-name">Cuentas Bancarias</span>
        <span class="module-desc">Movimientos y saldo de cada cuenta.</span>
    </a>
    <a class="module" href="operations" style="--swatch:var(--ink-soft)">
        <span class="module-name">Operaciones Acciones</span>
        <span class="module-desc">Compras, ventas y dividendos de todas las empresas.</span>
    </a>
</div>

@code {
    private decimal totalPatrimony = 0m;
    private string currencyCode = CurrencyFormatter.DefaultCurrency;

    protected override async Task OnInitializedAsync()
    {
        // Mismo patrimonio total que el Dashboard (antes salía del registro antiguo FinancialRecords,
        // que no cambiaba al crear o borrar inmuebles ni otras inversiones)
        try
        {
            var summary = await DashboardService.GetDashboardSummaryAsync();
            totalPatrimony = summary.TotalPatrimony;
            currencyCode = (await DashboardService.GetCurrencyInfoAsync()).CurrencyCode;
        }
        catch
        {
            totalPatrimony = 0m;
        }
    }
}
