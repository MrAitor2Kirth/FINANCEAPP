@page "/dashboard"
@using System.Globalization
@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using FINANCEAPP.Components.Pages.History
@using Microsoft.Extensions.Logging
@inject IDashboardService DashboardService
@inject IWealthSnapshotService WealthSnapshotService
@inject NavigationManager Navigation
@inject ILogger<FinancialDashboard> Logger

<PageTitle>Dashboard Financiero</PageTitle>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando datos...</span>
            </div>
        </div>
    }
    else if (summary != null)
    {
        var shares = BuildShares();
        var shareBase = shares.Sum(x => Math.Max(x.Value, 0m));

        <div class="page-head">
            <div class="page-head-title">
                <AppLogo Variant="compact" />
                <div>
                    <h1>Dashboard</h1>
                    <p class="page-sub">Gestión integral de tu patrimonio · actualizado @summary.LastUpdate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-primary" @onclick="RefreshDashboard">
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i> Actualizar
                </button>
                <button class="btn btn-primary" @onclick="OpenCapture">
                    <i class="bi bi-camera me-1" aria-hidden="true"></i> Capturar patrimonio
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(captureMessage))
        {
            <div class="alert alert-success alert-dismissible" role="status">
                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@captureMessage
                <a href="/history/wealth" class="ms-2">Ver histórico</a>
                <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => captureMessage = null"></button>
            </div>
        }

        <section class="wealth" aria-labelledby="wealth-label">
            <p class="eyebrow" id="wealth-label">Patrimonio total</p>
            <p class="wealth-total">@Money(summary.TotalPatrimony)</p>
            @if (variation != null)
            {
                <p class="wealth-variation @(variation.Amount >= 0 ? "text-success" : "text-danger")">
                    @(variation.Amount >= 0 ? "▲" : "▼") <span class="num">@Money(variation.Amount)</span>
                    @if (variation.Percent.HasValue)
                    {
                        <span class="num">(@variation.Percent.Value.ToString("N2")%)</span>
                    }
                    <span class="text-muted">desde @variation.ComparedToLabel</span>
                </p>
            }
            <div class="wealth-band" role="img" aria-label="Reparto del patrimonio por clase de activo">
                @foreach (var share in shares.Where(x => x.Value > 0m))
                {
                    <span class="wealth-seg" style="flex-grow:@Grow(share.Value, shareBase); background:@share.Color" title="@share.Name: @Money(share.Value)"></span>
                }
            </div>
        </section>

        @if (currencyInfo != null && (currencyInfo.ExcludedCompanies > 0 || currencyInfo.BaseCountryMissing))
        {
            <div class="alert alert-info mt-3" role="status">
                <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                @if (currencyInfo.BaseCountryMissing)
                {
                    <span>El país base guardado ya no existe en el catálogo: los totales se muestran en EUR. </span>
                }
                @if (currencyInfo.ExcludedCompanies > 0)
                {
                    <span>@currencyInfo.ExcludedCompanies @(currencyInfo.ExcludedCompanies == 1 ? "empresa en otra divisa sin tipo de cambio no incluida" : "empresas en otra divisa sin tipo de cambio no incluidas") en las acciones. <a href="/settings">Configurar tipos de cambio</a></span>
                }
            </div>
        }

        <div class="class-grid">
            @foreach (var share in shares)
            {
                <div class="class-card" style="--swatch:@share.Color">
                    <p class="class-name">@share.Name</p>
                    <p class="class-value">@Money(share.Value)</p>
                    <p class="class-meta">@Pct(share.Value, shareBase) del patrimonio</p>
                    @if (share.Invested.HasValue)
                    {
                        <p class="class-meta">Invertido: <span class="num">@Money(share.Invested.Value)</span></p>
                    }
                    <p class="class-meta">@share.Detail</p>
                </div>
            }
        </div>

        @* Alertas *@
        @if (alerts.Count > 0)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h5>Alertas</h5>
                    @foreach (var alert in alerts)
                    {
                        <div class="alert @GetAlertClass(alert.Level) mb-2" role="alert">
                            <strong>@alert.Title</strong> – @alert.Message
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row mb-4">
            @* Rendimiento de cartera *@
            <div class="col-lg-7 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><strong>Rendimiento de la cartera</strong> <small class="text-muted">(acciones y fondos)</small></div>
                    <div class="card-body">
                        @if (performance == null || performance.ByAssetClass.Count == 0)
                        {
                            <p class="text-muted mb-0">Aún no hay inversiones para calcular el rendimiento.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Clase de activo</th>
                                            <th class="text-end">Invertido</th>
                                            <th class="text-end">Valor actual</th>
                                            <th class="text-end">Resultado</th>
                                            <th class="text-end">%</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in performance.ByAssetClass)
                                        {
                                            <tr>
                                                <td>@row.AssetClass</td>
                                                <td class="text-end">@Money(row.Invested)</td>
                                                <td class="text-end">@Money(row.CurrentValue)</td>
                                                <td class="text-end @GetResultClass(row.Return)">@Money(row.Return)</td>
                                                <td class="text-end @GetResultClass(row.ReturnPercentage)">@Arrow(row.ReturnPercentage) @row.ReturnPercentage.ToString("N2")%</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td>Total</td>
                                            <td class="text-end">@Money(performance.TotalInvested)</td>
                                            <td class="text-end">@Money(performance.CurrentValue)</td>
                                            <td class="text-end @GetResultClass(performance.TotalReturn)">@Money(performance.TotalReturn)</td>
                                            <td class="text-end @GetResultClass(performance.ReturnPercentage)">@Arrow(performance.ReturnPercentage) @performance.ReturnPercentage.ToString("N2")%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Flujo de caja *@
            <div class="col-lg-5 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><strong>Flujo de caja</strong> <small class="text-muted">(inmuebles)</small></div>
                    <div class="card-body">
                        @if (cashFlow == null)
                        {
                            <p class="text-muted mb-0">Sin datos.</p>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between"><span>Ingresos por alquiler</span><strong class="text-success">@Money(cashFlow.TotalIncome)</strong></div>
                            <div class="d-flex justify-content-between"><span>Gastos</span><strong class="text-danger">@Money(cashFlow.TotalExpenses)</strong></div>
                            <hr />
                            <div class="d-flex justify-content-between"><span>Flujo neto</span><strong class="@GetResultClass(cashFlow.NetCashFlow)">@Money(cashFlow.NetCashFlow)</strong></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Operaciones recientes *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header"><strong>Operaciones recientes</strong></div>
                    <div class="card-body">
                        @if (recentOperations.Count == 0)
                        {
                            <p class="text-muted mb-0">No hay operaciones recientes.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Categoría</th>
                                            <th>Tipo</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var op in recentOperations)
                                        {
                                            <tr>
                                                <td>@op.Date.ToString("dd/MM/yyyy")</td>
                                                <td>@op.Category</td>
                                                <td>@op.Type</td>
                                                <td>@op.Description</td>
                                                <td class="text-end">@Money(op.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <h5>Acceso Rápido a Módulos</h5>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-primary w-100" @onclick="NavigateToFunds">
                    Fondos de Inversión
                </button>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-primary w-100" @onclick="NavigateToBank">
                    Cuentas Bancarias
                </button>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-primary w-100" @onclick="NavigateToRefugio">
                    Activos Refugio
                </button>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-primary w-100" @onclick="NavigateToProperties">
                    Propiedades
                </button>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-outline-primary w-100" @onclick="NavigateToHistory">
                    Histórico
                </button>
            </div>
        </div>
    }
</div>

<WealthCaptureModal @ref="captureModal" OnCaptured="OnCaptured" />

@code {
    private DashboardSummary? summary;
    private PortfolioPerformance? performance;
    private IncomeExpenseStats? cashFlow;
    private List<RecentOperation> recentOperations = new();
    private List<DashboardAlert> alerts = new();
    private DashboardCurrencyInfo? currencyInfo;
    private WealthVariation? variation;
    private WealthCaptureModal? captureModal;
    private string? captureMessage;
    private bool isLoading = true;

    /// <summary>Importe con el símbolo de la divisa base (SPEC-01-02)</summary>
    private string Money(decimal amount) =>
        CurrencyFormatter.Format(amount, currencyInfo?.CurrencyCode);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        try
        {
            isLoading = true;
            currencyInfo = await DashboardService.GetCurrencyInfoAsync();
            summary = await DashboardService.GetDashboardSummaryAsync();
            performance = await DashboardService.GetPortfolioPerformanceAsync();
            cashFlow = await DashboardService.GetIncomeExpenseStatsAsync();
            recentOperations = await DashboardService.GetRecentOperationsAsync(10);
            alerts = await DashboardService.GetDashboardAlertsAsync();
            await LoadVariationAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando dashboard");
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>Variación frente a la última captura de un mes anterior (SPEC-17-01). Si falla, no se muestra.</summary>
    private async Task LoadVariationAsync()
    {
        try
        {
            variation = summary == null
                ? null
                : await WealthSnapshotService.GetDashboardVariationAsync(
                    DateTime.Now, summary.TotalPatrimony, currencyInfo?.CurrencyCode ?? CurrencyFormatter.DefaultCurrency);
        }
        catch (Exception ex)
        {
            variation = null;
            Logger.LogWarning(ex, "No se pudo calcular la variación frente a la última captura");
        }
    }

    private static string GetAlertClass(string level) => level switch
    {
        "danger" => "alert-danger",
        "warning" => "alert-warning",
        _ => "alert-info"
    };

    private static string GetResultClass(decimal value) => value >= 0 ? "text-success" : "text-danger";

    private static string Arrow(decimal value) => value >= 0 ? "▲" : "▼";

    private sealed record ClassShare(string Name, string Color, decimal Value, decimal? Invested, string Detail);

    private List<ClassShare> BuildShares() => summary is null ? new List<ClassShare>() : new List<ClassShare>
    {
        new ClassShare("Acciones", "#3F3B9B", summary.AccionesTotal, summary.AccionesInitialTotal, $"{summary.CompaniesCount} empresas"),
        new ClassShare("Fondos de inversión", "#1F8A93", summary.FundsTotal, summary.FundsInitialTotal, $"{summary.FundsCount} fondos"),
        new ClassShare("Activos refugio", "#E0A030", summary.SafeHavenTotal, summary.SafeHavenInitialTotal, $"{summary.SafeHavenAssetsCount} activos"),
        new ClassShare("Inmuebles", "#9A4F8C", summary.RealEstateTotal, null, $"{summary.PropertiesCount} propiedades"),
        new ClassShare("Efectivo bancario", "#7FB08F", summary.BankTotal, null, $"{summary.BankAccountsCount} cuentas")
    };

    // Proporcion de cada clase sobre la suma de las clases (solo valores positivos), para la banda y el porcentaje.
    private static string Grow(decimal value, decimal total) =>
        (total > 0m ? Math.Max(value, 0m) / total * 100m : 0m).ToString("0.####", CultureInfo.InvariantCulture);

    private static string Pct(decimal value, decimal total) =>
        total > 0m ? (Math.Max(value, 0m) / total).ToString("P1") : "—";

    private async Task RefreshDashboard()
    {
        await LoadDashboard();
    }

    private void NavigateToFunds() => Navigation.NavigateTo("/fondos");
    private void NavigateToBank() => Navigation.NavigateTo("/banco");
    private void NavigateToRefugio() => Navigation.NavigateTo("/activos-refugio");
    private void NavigateToProperties() => Navigation.NavigateTo("/inmuebles");
    private void NavigateToHistory() => Navigation.NavigateTo("/history");

    private async Task OpenCapture()
    {
        if (captureModal != null)
        {
            await captureModal.ShowAsync();
        }
    }

    private async Task OnCaptured(WealthSnapshot saved)
    {
        captureMessage = $"Captura de {saved.PeriodLabel} guardada.";
        await LoadVariationAsync();
    }
}
