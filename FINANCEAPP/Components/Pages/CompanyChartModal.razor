        comparePickerOpen = false;
        comparedSeries = null;
        comparedPoints = new();
        comparison = null;
        comparisonStartMs = null;
        comparisonEndMs = null;
        isLoadingComparison = false;
        comparisonWarning = null;
    }

    private void CancelComparedBackfill()
    {
        if (comparedBackfillCts != null)
        {
            comparedBackfillCts.Cancel();
            comparedBackfillCts.Dispose();
            comparedBackfillCts = null;
        }

