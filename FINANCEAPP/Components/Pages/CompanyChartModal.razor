    // ---------------------------------------------------------------- Marcas (SPEC-05-03)

    private void OpenMarkForm(ChartMark? mark)
    {
        // El formulario edita una copia, nunca la entidad
        editingMarkId = mark?.Id;
        markInput = mark == null
            ? new ChartMarkInput { Date = DateTime.Today }
            : new ChartMarkInput { Date = mark.Date, Description = mark.Description, IsGlobal = mark.IsGlobal };
        markError = null;
        confirmDeleteMarkId = null;
        markFormOpen = true;
    }

    private void CancelMarkForm()
    {
        markFormOpen = false;
        editingMarkId = null;
        markError = null;
    }

    private async Task SaveMarkAsync()
    {
        if (company == null || isSavingMark)
        {
            return;
        }

        isSavingMark = true;
        markError = null;
        try
        {
            ChartMarkResult? result = null;
            await RunExclusiveAsync(async () =>
            {
                result = editingMarkId.HasValue
                    ? await ChartMarkService.UpdateAsync(editingMarkId.Value, company.Id, markInput)
                    : await ChartMarkService.CreateAsync(company.Id, markInput);

                if (result.Success)
                {
                    marks = await ChartMarkService.GetForCompanyAsync(company.Id);
                }
            });

            if (result == null || !result.Success)
            {
                markError = result?.ErrorMessage ?? "No se pudo guardar la marca.";
                return;
            }

            markFormOpen = false;
            editingMarkId = null;
            await UpdateChartDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar una marca del gráfico");
            markError = "No se pudo guardar la marca. No se ha modificado nada.";
        }
        finally
        {
            isSavingMark = false;
            StateHasChanged();
        }
    }

    private Task SetMarkActiveAsync(ChartMark mark, bool isActive)
    {
        return ChangeMarkAsync(() => ChartMarkService.SetActiveAsync(mark.Id, isActive));
    }

    private Task DeleteMarkAsync(int markId)
    {
        confirmDeleteMarkId = null;
        if (editingMarkId == markId)
        {
            CancelMarkForm();
        }

        return ChangeMarkAsync(() => ChartMarkService.DeleteAsync(markId));
    }

    private async Task ChangeMarkAsync(Func<Task<ChartMarkResult>> change)
    {
        if (company == null)
        {
            return;
        }

        markPanelError = null;
        try
        {
            ChartMarkResult? result = null;
            await RunExclusiveAsync(async () =>
            {
                result = await change();
                marks = await ChartMarkService.GetForCompanyAsync(company.Id);
            });

            if (result != null && !result.Success)
            {
                markPanelError = result.ErrorMessage;
            }

            await UpdateChartDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cambiar una marca del gráfico");
            markPanelError = "No se pudo guardar el cambio de la marca.";
        }
    }

    // ---------------------------------------------------------------- Precio en vivo

    private Task RefreshQuoteNowAsync() => RefreshQuoteAsync(CancellationToken.None);

    private async Task RefreshQuoteAsync(CancellationToken token)
    {
        if (isRefreshingQuote || company == null || string.IsNullOrWhiteSpace(company.Ticker) || token.IsCancellationRequested)
        {
            return;
        }

        isRefreshingQuote = true;
        StateHasChanged();

        StockQuote? newQuote = null;
        try
        {
            await RunExclusiveAsync(async () =>
            {
                newQuote = await CompanyService.RefreshLiveQuoteAsync(company.Id, resolvedSymbol);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al refrescar el precio en vivo de {Company}", company.Name);
        }
        finally
        {
            isRefreshingQuote = false;
        }

        if (token.IsCancellationRequested || !isVisible)
        {
            return;
        }

        if (newQuote != null)
        {
            quote = newQuote;
            resolvedSymbol = newQuote.Symbol;
            quoteFailed = false;
            lastQuoteAt = DateTime.Now;
            company.LivePrice = newQuote.Price;
            company.LivePriceUpdatedAt = DateTime.Now;

            // El precio del formulario sigue al vivo hasta confirmar, salvo que se haya escrito a mano (D10)
            if (tradeType != null && followLivePrice)
            {
                tradePrice = Math.Round(newQuote.Price, 2);
            }

            try
            {
                await JS.InvokeVoidAsync("companyChart.updateLive", chartElementId, newQuote.Price, TodayMs());
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "No se pudo actualizar el precio en el gráfico");
            }
        }
        else
        {
            quoteFailed = true;
        }

        UpdateMarketState();
        StateHasChanged();
    }

    private void UpdateMarketState()
    {
        marketState = quote?.GetMarketState(DateTime.UtcNow) ?? MarketState.Unknown;
    }

    // ---------------------------------------------------------------- Operar

    private async Task OpenTradeForm(string type)
    {
        if (quote == null)
        {
            return;
        }

        tradeType = type;
        tradeDate = DateTime.Today;
        tradeShares = 1;
        tradePrice = Math.Round(quote.Price, 2);
        tradeCommission = 0m;
        followLivePrice = true;
        tradeError = null;
        successMessage = null;
        tradeExchangeRate = null;
        tradeBankAccountName = string.Empty;
        UpdateMarketState();

        await RunExclusiveAsync(async () =>
        {
            if (!IsBaseCurrency)
            {
                tradeExchangeRate = (await ExchangeRateService.GetCurrentRateAsync(CurrencyCode))?.Rate;
            }

            // Cuentas para ingresar la venta (el servicio lo revalida al confirmar)
            tradeBankAccounts = await BankService.GetAllBankAccountsAsync();
            defaultTradeBankAccountName = (await BankService.GetDefaultBankAccountAsync())?.Name;
        });
    }

    // El precio por acción se guarda con 2 decimales
    private void RoundTradePrice() => tradePrice = Math.Round(tradePrice, 2);

    private void StopFollowingLivePrice()
    {
        followLivePrice = false;
    }

    private void FollowLivePriceAgain()
    {
        followLivePrice = true;
        if (quote != null)
        {
            tradePrice = Math.Round(quote.Price, 2);
        }
    }

    private void CancelTrade()
    {
        tradeType = null;
        tradeError = null;
    }

    private async Task ConfirmTradeAsync()
    {
        if (isSaving || tradeType == null || company == null)
        {
            return;
        }

        isSaving = true;
        tradeError = null;
        UpdateMarketState();

        var request = new QuickTradeRequest
        {
            CompanyId = company.Id,
            Type = tradeType,
            Date = tradeDate,
            NumberOfShares = tradeShares,
            PricePerShare = tradePrice,
            Commission = tradeCommission,
            ExchangeRate = IsBaseCurrency ? null : tradeExchangeRate,
            MarketState = marketState,
            BankAccountName = tradeBankAccountName
        };

        try
        {
            QuickTradeResult? result = null;
            await RunExclusiveAsync(async () =>
            {
                result = await OperationService.RegisterQuickTradeAsync(request);

                if (result.Success)
                {
                    company = await CompanyService.GetByIdAsync(company.Id) ?? company;
                    if (quote != null)
                    {
                        company.LivePrice = quote.Price;
                    }
                    await LoadOperationDataAsync();
                }
            });

            if (result == null || !result.Success)
            {
                // El formulario sigue abierto para poder corregir (RF-9)
                tradeError = result?.ErrorMessage ?? "No se pudo registrar la operación.";
                return;
            }

            operated = true;
            successMessage = $"{(request.Type == "Compra" ? "Compra" : "Venta")} registrada: {ShareQuantity.Format(request.NumberOfShares)} acciones a {CurrencyFormatter.Format(request.PricePerShare, CurrencyCode)}.";
            tradeType = null;
            await RenderChartAsync(await GetChartViewAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar la operación desde el gráfico");
            tradeError = "No se pudo registrar la operación. No se ha guardado nada.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
