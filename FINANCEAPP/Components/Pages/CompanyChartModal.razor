    // Líneas del calendario de dividendos de la empresa, como «Pago de dividendo» (SPEC-21-01, RF-9)
    private List<DividendChartMark> dividendMarks = new();

    // Comparación con otra empresa o un índice (SPEC-05-04). No se recuerda entre aperturas (RF-3)
    private bool comparePickerOpen;
    private List<CompanyDetail> compareCompanies = new();
    private List<BenchmarkIndexSummary> compareIndices = new();
    private ChartSeriesRef? comparedSeries;
