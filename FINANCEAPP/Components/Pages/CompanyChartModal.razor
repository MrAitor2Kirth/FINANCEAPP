    private string? successMessage;

    private string CurrencyCode => CurrencyFormatter.Normalize(company?.CurrencyCode);

    // Símbolo para el histórico: el resuelto por el precio en vivo (p. ej. ACS.MC) evita repetir la prueba de sufijos
    private string HistorySymbol => resolvedSymbol ?? company?.Ticker ?? string.Empty;

    private bool IsBaseCurrency => string.Equals(CurrencyCode, baseCurrencyCode, StringComparison.OrdinalIgnoreCase);

    private bool HasPosition => company != null && company.NumberOfShares > 0 && company.AveragePurchasePrice.HasValue;

    private decimal UnrealizedResult => company == null ? 0m : company.TotalInvestedValue - company.TotalInvestedInitial;

    private decimal? TradeAmount => OperationAmountCalculator.Calculate(tradePrice, null, tradeShares, tradeCommission);

    private string? TradeBlockReason => tradeType == null
        ? null
        : OperationService.GetQuickTradeBlockReason(tradeType, tradeDate, marketState, availableShares, tradeBankAccounts.Count > 0);

    private string MarketLabel => marketState switch
    {
        MarketState.Open => "Mercado abierto",
        MarketState.Closed => "Mercado cerrado",
        _ => "Mercado: desconocido"
    };

    private string MarketBadgeClass => marketState switch
    {
        MarketState.Open => "open",
        MarketState.Closed => "closed",
        _ => "unknown"
    };

    /// <summary>
    /// Abre el modal y carga el gráfico de cotización y el precio en vivo de la empresa indicada.
    /// </summary>
    public async Task ShowAsync(CompanyDetail selectedCompany)
    {
        await StopAsync();

        isActive = true;
        company = selectedCompany;
        granularity = ChartGranularity.Daily;
        quote = null;
        resolvedSymbol = null;
        quoteFailed = false;
        lastQuoteAt = null;
        marketState = MarketState.Unknown;
        tradeType = null;
        successMessage = null;
        historyWarning = null;
        backfillMessage = null;
        hourlyBackfillMessage = null;
        backfillError = null;
        chartError = null;
        operated = false;
        hiddenKinds.Clear();
        markFormOpen = false;
        editingMarkId = null;
        markError = null;
        markPanelError = null;
        confirmDeleteMarkId = null;
        ResetComparison();
        isVisible = true;
        isLoadingChart = true;
        StateHasChanged();

        await RunExclusiveAsync(async () =>
        {
            company = await CompanyService.GetByIdAsync(selectedCompany.Id) ?? selectedCompany;
            preferences = await AppSettingsService.GetChartPreferencesAsync();
            baseCurrencyCode = CurrencyFormatter.Normalize((await CountryService.GetBaseCurrencyAsync()).CurrencyCode);
            await LoadOperationDataAsync();
            await LoadHistoryAsync(false);
        });

        await RenderChartAsync();
        await RefreshQuoteAsync(CancellationToken.None);
        StartLiveLoop();

        // El histórico antiguo llega después, sin hacer esperar al primer dibujo (SPEC-05-02, RF-2)
        StartBackfill();
    }

    // ---------------------------------------------------------------- Ciclo de vida

    private void StartLiveLoop()
    {
        if (string.IsNullOrWhiteSpace(company?.Ticker))
        {
            return;
        }

        liveCts = new CancellationTokenSource();
        _ = LiveLoopAsync(liveCts.Token);
    }

    private async Task LiveLoopAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(LiveRefreshInterval);
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() => RefreshQuoteAsync(token));
            }
        }
        catch (OperationCanceledException)
        {
            // Modal cerrado
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en el refresco automático del precio en vivo");
        }
    }

    /// <summary>
    /// Detiene el refresco, destruye el gráfico y libera el ámbito de servicios (RF-15)
    /// </summary>
    private async Task StopAsync()
    {
        if (liveCts != null)
        {
            liveCts.Cancel();
            liveCts.Dispose();
            liveCts = null;
        }

        // Las descargas en segundo plano se cancelan; lo ya guardado se queda (SPEC-05-02, RF-5)
        CancelBackfill();
        CancelHourly();
        CancelComparedBackfill();

        try
        {
            await JS.InvokeVoidAsync("companyChart.destroy", chartElementId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // La página ya no está disponible: no hay nada que destruir
        }

        if (isActive)
        {
            isActive = false;

            // Se espera a que termine la consulta en curso: el DbContext es compartido y la página
            // que recarga después no puede usarlo a la vez
            await dataLock.WaitAsync();
            dataLock.Release();
        }
    }

    private async Task CloseAsync()
    {
        isVisible = false;
        tradeType = null;
        await StopAsync();
        await OnClosed.InvokeAsync(operated);
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    /// <summary>
    /// Ejecuta un acceso a datos en exclusiva (sin consultas simultáneas sobre el DbContext del modal)
    /// </summary>
    private async Task RunExclusiveAsync(Func<Task> action)
    {
        await dataLock.WaitAsync();
        try
        {
            // Si el modal se cerró mientras se esperaba el turno, no se consulta nada
            if (isActive)
            {
                await action();
            }
        }
        finally
        {
            dataLock.Release();
        }
    }

    // ---------------------------------------------------------------- Datos e histórico

    /// <summary>
    /// Carga una sola vez por apertura (y tras operar) los marcadores, las acciones disponibles y el tipo de cambio (RF-17)
    /// </summary>
    private async Task LoadOperationDataAsync()
    {
        if (company == null)
        {
            return;
        }

        markers = await OperationService.GetChartMarkersAsync(company.Name);
        availableShares = await OperationService.GetAvailableSharesAsync(company.Name);
        marks = await ChartMarkService.GetForCompanyAsync(company.Id);
        dividendMarks = await DividendService.GetChartMarksAsync(company.Id);
    }

    /// <summary>
    /// Carga el histórico diario (o su agregación) de la temporalidad activa. Con <paramref name="cacheOnly"/>
    /// se lee solo la caché, sin Yahoo: cambio de temporalidad y bloques del segundo plano (SPEC-05-02).
    /// </summary>
    private async Task LoadHistoryAsync(bool forceRefresh, bool cacheOnly = false)
    {
        if (company == null)
        {
            return;
        }

        try
        {
            if (cacheOnly)
            {
                ApplyHistoryResult(await PriceHistoryService.GetCachedHistoryAsync(company.Id, granularity));
                chartError = points.Count > 0 ? null : "No hay histórico de cotización para este ticker.";
                return;
            }

            historyWarning = null;
            var result = await PriceHistoryService.GetHistoryWithStatusAsync(company.Id, HistorySymbol, granularity, forceRefresh);
            ApplyHistoryResult(result);

            if (result.RefreshFailed && points.Count > 0)
            {
                historyWarning = HasInternet()
                    ? "No se pudo descargar el histórico de Yahoo Finance; se muestra el guardado."
                    : "Sin conexión a Internet; se muestra el histórico guardado.";
            }

            chartError = points.Count > 0
                ? null
                : HasInternet()
                    ? "No hay histórico de cotización para este ticker."
                    : "No se pudo conectar con Yahoo Finance: no hay conexión a Internet.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar el histórico de cotización de {Company}", company.Name);
            points = new();
            chartError = "No se pudo conectar con Yahoo Finance.";
        }
    }

    private void ApplyHistoryResult(PriceHistoryResult result)
    {
        points = result.Points;
        viewStart = result.ViewStart;
        viewEnd = result.ViewEnd;
    }

    /// <summary>
    /// Carga las barras de una hora del último mes, o las que haya en memoria (SPEC-05-02, RF-9)
    /// </summary>
    private async Task LoadHourlyAsync(CancellationToken token)
    {
        if (company == null)
        {
            return;
        }

        historyWarning = null;
        try
        {
            var result = await PriceHistoryService.GetHourlyAsync(company.Id, HistorySymbol, token);
            ApplyHistoryResult(result);

            chartError = points.Count > 0
                ? null
                : !result.RefreshFailed
                    ? "Yahoo no ofrece barras horarias para este ticker."
                    : HasInternet()
                        ? "No se pudieron descargar las barras horarias de Yahoo Finance."
                        : "Sin conexión a Internet: la vista de Horas necesita conexión.";
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar las barras de una hora de {Company}", company.Name);
            points = new();
            chartError = "No se pudo conectar con Yahoo Finance.";
        }
    }

    private static bool HasInternet()
    {
        try
        {
            return Microsoft.Maui.Networking.Connectivity.Current.NetworkAccess == Microsoft.Maui.Networking.NetworkAccess.Internet;
        }
        catch
        {
            return true;
        }
    }

    /// <summary>
    /// Dibuja el gráfico desde cero. Con <paramref name="keepView"/> conserva ese tramo en lugar del inicial
    /// (cambio de capas, SPEC-05-03, RF-4).
    /// </summary>
    private async Task RenderChartAsync(ChartView? keepView = null)
    {
        isLoadingChart = false;
        StateHasChanged();

        if (company == null || chartError != null || points.Count == 0 || !isVisible)
        {
            return;
        }

        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            if (keepView != null && IsComparing)
            {
                // Las series en base 100 salen ya calculadas para el tramo que se va a ver
                comparisonStartMs = keepView.Start;
                comparisonEndMs = keepView.End;
            }

            await JS.InvokeVoidAsync("companyChart.render", chartElementId, volumeElementId, BuildChartPayload(keepView), navigatorElementId, dotNetRef);

            if (quote != null && granularity == ChartGranularity.Daily)
            {
                await JS.InvokeVoidAsync("companyChart.updateLive", chartElementId, quote.Price, TodayMs());
            }
        }
        catch (JSException ex) when (ex.Message.Contains("APEXCHARTS_NOT_LOADED"))
        {
            chartError = "No se pudo cargar la librería de gráficos (¿sin conexión a Internet?).";
            StateHasChanged();
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Error al dibujar el gráfico de cotización");
            chartError = "No se pudo dibujar el gráfico de cotización.";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Datos del gráfico en JSON para companyChart.render y companyChart.updateData
    /// </summary>
    private string BuildChartPayload(ChartView? keepView = null)
    {
        // Cada marcador y cada marca van a su periodo: primera barra del día en Horas, inicio de la semana,
        // mes o año en las agregadas (SPEC-05-02, RF-11; SPEC-05-03, RF-10)
        // Al comparar no se dibujan operaciones ni pagos de dividendo; las marcas sí (SPEC-05-04, RF-4b)
        var chartMarkers = IsComparing
            ? new List<ChartMarker>()
            : PriceHistoryService.AlignMarkers(markers, points, granularity);
        var chartMarks = preferences.ShowMarks
            ? PriceHistoryService.AlignMarks(marks.Where(m => m.IsActive), points, granularity)
            : new List<ChartMarkPoint>();

        // Tramo futuro hasta 1 año o el pago pendiente más lejano, y pagos de dividendo (SPEC-21-01, RF-9 y RF-10)
        var futureSessions = PriceHistoryService.BuildFutureSessions(points, granularity,
            dividendMarks.Where(d => d.Status == DividendPaymentRules.StatusPending).Select(d => d.PaymentDate));
        var dividendPoints = preferences.ShowMarks && !IsComparing
            ? PriceHistoryService.AlignDividendMarks(dividendMarks, points, granularity)
            : new List<DividendMarkPoint>();

        var payload = new
        {
            series = points.Select(p => new
            {
                x = ToMs(p.Date),
                o = p.Open,
                h = p.High,
                l = p.Low,
                c = p.Close,
                v = p.Volume,
                tv = p.TradedValue
            }),
            markers = chartMarkers.Select(m => new
            {
                kind = m.Kind.ToString(),
                date = ToMs(m.Date),
                dateLabel = (m.OperationDate ?? m.Date).ToString("dd/MM/yyyy"),
                price = m.Price,
                shares = m.Shares,
                amount = m.Amount
            }),
            currentPrice = quote?.Price ?? company?.LivePrice ?? (company?.CurrentPrice > 0 ? company.CurrentPrice : (decimal?)null),
            averagePrice = company?.AveragePurchasePrice,
            currencySymbol = CurrencyFormatter.Symbol(CurrencyCode),
            showCandles = preferences.ShowCandles,
            showVolume = preferences.ShowVolume,
            showAverage = preferences.ShowAverage && HasPosition,
            isDaily = granularity == ChartGranularity.Daily,
            granularity = granularity.ToString(),
            viewStart = viewStart.HasValue ? ToMs(viewStart.Value) : (long?)null,
            viewEnd = viewEnd.HasValue ? ToMs(viewEnd.Value) : (long?)null,
            marks = chartMarks.Select(k => new
            {
                id = k.Id,
                date = ToMs(k.Date),
                dateLabel = k.MarkDate.ToString("dd/MM/yyyy"),
                description = k.Description,
                isGlobal = k.IsGlobal
            }),
            showMarks = preferences.ShowMarks,
            futureSessions = futureSessions.Select(ToMs),
            dividendMarks = dividendPoints.Select(d => new
            {
                id = d.Id,
                date = ToMs(d.Date),
                paymentLabel = d.PaymentDate.ToString("dd/MM/yyyy"),
                exLabel = d.ExDividendDate?.ToString("dd/MM/yyyy"),
                status = d.Status,
                totalText = d.TotalAmount.HasValue ? CurrencyFormatter.Format(d.TotalAmount.Value, d.CurrencyCode) : null,
                isFuture = d.IsFuture
            }),
            hiddenKinds = hiddenKinds.ToArray(),
            keepView = keepView == null ? null : new { start = keepView.Start, end = keepView.End },
            comparison = BuildComparisonPayload()
        };

        return JsonSerializer.Serialize(payload);
    }

    /// <summary>
    /// Añade al gráfico los datos nuevos (bloque del segundo plano) sin mover la vista (SPEC-05-02, RF-4)
    /// </summary>
    private async Task UpdateChartDataAsync()
    {
        if (company == null || !isVisible || isLoadingChart)
        {
            return;
        }

        // Si antes no había datos (o no se pudo dibujar), se dibuja desde cero
        if (chartError != null || points.Count == 0)
        {
            chartError = points.Count > 0 ? null : chartError;
            await RenderChartAsync();
            return;
        }

        try
        {
            var updated = await JS.InvokeAsync<bool>("companyChart.updateData", chartElementId, BuildChartPayload());
            if (!updated)
            {
                await RenderChartAsync();
                return;
            }

            if (quote != null && granularity == ChartGranularity.Daily)
            {
                await JS.InvokeVoidAsync("companyChart.updateLive", chartElementId, quote.Price, TodayMs());
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "No se pudieron añadir los datos nuevos al gráfico");
        }
    }

    private static long ToMs(DateTime date) => new DateTimeOffset(date).ToUnixTimeMilliseconds();

    private static long TodayMs() => new DateTimeOffset(DateTime.Today).ToUnixTimeMilliseconds();

    private async Task ChangeGranularityAsync(ChartGranularity newGranularity)
    {
        if (granularity == newGranularity || isLoadingChart)
        {
            return;
        }

        // La descarga de Horas se cancela al salir de Horas (RF-9); la del diario sigue
        CancelHourly();
        granularity = newGranularity;
        isLoadingChart = true;
        StateHasChanged();

        if (newGranularity == ChartGranularity.Hourly)
        {
            await ShowHourlyAsync(false);
            return;
        }

        // El diario ya se refrescó al abrir: se lee de la caché, sin Yahoo
        await RunExclusiveAsync(() => LoadHistoryAsync(false, cacheOnly: true));
        await LoadComparedForGranularityAsync(CancellationToken.None);
        await RenderChartAsync();
    }

    /// <summary>
    /// Dibuja Horas con el último mes y arranca la descarga del resto en segundo plano (SPEC-05-02, RF-9)
    /// </summary>
    private async Task ShowHourlyAsync(bool forceRefresh)
    {
        if (company == null)
        {
            return;
        }

        if (forceRefresh)
        {
            PriceHistoryService.ClearHourly(company.Id);
        }

        hourlyCts = new CancellationTokenSource();
        var token = hourlyCts.Token;
        try
        {
            await LoadHourlyAsync(token);
            await LoadComparedForGranularityAsync(token);
        }
        catch (OperationCanceledException)
        {
            isLoadingChart = false;
            return;
        }

        await RenderChartAsync();

        if (points.Count > 0 && !PriceHistoryService.GetCachedHourly(company.Id).IsComplete)
        {
            _ = HourlyLoopAsync(token);
        }
    }

    private async Task ReloadHistoryAsync()
    {
        if (isLoadingChart)
        {
            return;
        }

        isLoadingChart = true;
        backfillError = null;
        StateHasChanged();

        if (granularity == ChartGranularity.Hourly)
        {
            // También se refresca el diario (RF-13); en pantalla se quedan las barras de una hora
            CancelHourly();
            await RunExclusiveAsync(async () =>
            {
                var daily = await PriceHistoryService.GetHistoryWithStatusAsync(company!.Id, HistorySymbol, ChartGranularity.Daily, true);
                if (daily.RefreshFailed)
                {
                    historyWarning = "No se pudo descargar el histórico diario de Yahoo Finance; se conserva el guardado.";
                }
            });
            await ShowHourlyAsync(true);
        }
        else
        {
            await RunExclusiveAsync(() => LoadHistoryAsync(true));
            await LoadComparedForGranularityAsync(CancellationToken.None);
            await RenderChartAsync();
        }

        // Si el histórico antiguo no está completo, se reanuda su descarga
        StartBackfill();
    }

    private async Task ResetViewAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("companyChart.resetView", chartElementId);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "No se pudo volver a la vista inicial del gráfico");
        }
    }

    // ---------------------------------------------------------------- Segundo plano (SPEC-05-02)

    private void StartBackfill()
    {
        if (isBackfilling || company == null || string.IsNullOrWhiteSpace(company.Ticker) || !isActive)
        {
            return;
        }

        CancelBackfill();
        isBackfilling = true;
        backfillCts = new CancellationTokenSource();
        backfillTask = BackfillLoopAsync(++backfillRun, backfillCts.Token);
    }

    private void CancelBackfill()
    {
        if (backfillCts != null)
        {
            backfillCts.Cancel();
            backfillCts.Dispose();
            backfillCts = null;
        }

        backfillRun++;
        isBackfilling = false;
        backfillMessage = null;
    }

    private void CancelHourly()
    {
        if (hourlyCts != null)
        {
            hourlyCts.Cancel();
            hourlyCts.Dispose();
            hourlyCts = null;
        }

        hourlyBackfillMessage = null;
    }

    /// <summary>
    /// Completa hacia atrás el histórico diario por bloques de 10 años: descarga fuera del semáforo y
    /// guarda dentro, con el DbContext compartido (SPEC-05-02, RF-2, RF-4 y RF-5)
    /// </summary>
    private async Task BackfillLoopAsync(int run, CancellationToken token)
    {
        if (company == null)
        {
            return;
        }

        var companyId = company.Id;
        try
        {
            HistoryBackfillState? state = null;
            await RunExclusiveAsync(async () => state = await PriceHistoryService.GetBackfillStateAsync(companyId));
            if (state == null || state.IsComplete || state.OldestDate == null)
            {
                return;
            }

            var cursor = state.OldestDate.Value;
            var oldestShown = cursor;
            while (!token.IsCancellationRequested)
            {
                backfillMessage = $"Descargando histórico anterior… (desde {oldestShown.Year})";
                await InvokeAsync(StateHasChanged);

                var block = await PriceHistoryService.FetchOlderDailyBlockAsync(HistorySymbol, cursor, token);
                if (token.IsCancellationRequested)
                {
                    return;
                }

                if (block.Failed)
                {
                    backfillError = $"No se pudo descargar el histórico anterior a {cursor:dd/MM/yyyy}; se reintentará la próxima vez.";
                    return;
                }

                var saved = false;
                var reloaded = false;
                await RunExclusiveAsync(async () =>
                {
                    await PriceHistoryService.SaveDailyBlockAsync(companyId, block);
                    saved = true;

                    // Se recalcula la temporalidad activa con los datos nuevos (Horas no sale del diario)
                    if (granularity != ChartGranularity.Hourly && !isLoadingChart)
                    {
                        await LoadHistoryAsync(false, cacheOnly: true);
                        reloaded = true;
                    }
                });

                if (!saved || token.IsCancellationRequested)
                {
                    return;
                }

                if (reloaded && granularity != ChartGranularity.Hourly)
                {
                    await UpdateChartDataAsync();
                }

                if (block.ReachedStart)
                {
                    return;
                }

                cursor = block.BlockStart;
                if (block.OldestDate.HasValue)
                {
                    oldestShown = block.OldestDate.Value;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Modal cerrado: lo ya guardado se queda y se reanuda en la próxima apertura
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al descargar el histórico anterior de {Company}", company?.Name);
            backfillError = "No se pudo completar el histórico anterior; se reintentará la próxima vez.";
        }
        finally
        {
            if (run == backfillRun)
            {
                isBackfilling = false;
                backfillMessage = null;
            }

            if (isVisible)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    /// <summary>
    /// Completa en memoria las barras de una hora hasta el límite de Yahoo (SPEC-05-02, RF-9)
    /// </summary>
    private async Task HourlyLoopAsync(CancellationToken token)
    {
        if (company == null)
        {
            return;
        }

        var companyId = company.Id;
        try
        {
            while (!token.IsCancellationRequested)
            {
                var current = PriceHistoryService.GetCachedHourly(companyId);
                if (current.IsComplete || current.OldestDate == null)
                {
                    return;
                }

                hourlyBackfillMessage = $"Descargando horas anteriores… (desde {current.OldestDate.Value:dd/MM/yyyy})";
                await InvokeAsync(StateHasChanged);

                var block = await PriceHistoryService.FetchOlderHourlyBlockAsync(companyId, HistorySymbol, token);
                if (token.IsCancellationRequested || granularity != ChartGranularity.Hourly)
                {
                    return;
                }

                if (block.Failed)
                {
                    backfillError = "No se pudieron descargar las horas anteriores; se reintentará al volver a Horas.";
                    return;
                }

                ApplyHistoryResult(PriceHistoryService.GetCachedHourly(companyId));

                // La serie comparada se amplía con el mismo tramo de horas (SPEC-05-04, RF-5)
                var series = comparedSeries;
                if (series != null)
                {
                    await PriceHistoryService.FetchOlderSeriesHourlyBlockAsync(series, token);
                    if (comparedSeries == series)
                    {
                        comparedPoints = PriceHistoryService.GetCachedSeriesHourly(series).Points;
                    }
                }

                await UpdateChartDataAsync();

                if (block.ReachedStart)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Se salió de Horas o se cerró el modal
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al descargar las horas anteriores de {Company}", company?.Name);
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                hourlyBackfillMessage = null;
            }

            if (isVisible)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ToggleLayerAsync(string layer, bool value)
    {
        switch (layer)
        {
            case LayerAverage: preferences.ShowAverage = value; break;
            case LayerCandles: preferences.ShowCandles = value; break;
            case LayerVolume: preferences.ShowVolume = value; break;
            case LayerMarks: preferences.ShowMarks = value; break;
        }

        // El tramo que se está mirando se conserva al redibujar (SPEC-05-03, RF-4)
        var view = await GetChartViewAsync();

        await RunExclusiveAsync(async () =>
        {
            var result = await AppSettingsService.SaveChartPreferencesAsync(preferences);
            if (!result.Success)
            {
                Logger.LogWarning("No se guardaron las preferencias del gráfico: {Error}", result.ErrorMessage);
            }
        });

        // Las capas solo cambian el dibujo: no se vuelve a consultar el histórico
        await RenderChartAsync(view);
    }

