@using System.Text.Json
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IPriceHistoryService PriceHistoryService
@inject IOperationService OperationService
@inject ICompanyService CompanyService
@inject IAppSettingsService AppSettingsService
@inject IExchangeRateService ExchangeRateService
@inject IBankService BankService
@inject ICountryService CountryService
@inject IChartMarkService ChartMarkService
@inject IDividendService DividendService
@inject IBenchmarkIndexService BenchmarkIndexService
@inject IJSRuntime JS
@inject ILogger<CompanyChartModal> Logger

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>
                        Cotización de @company?.Name (@company?.Ticker)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @* ---------- Visor de precio en vivo (RF-1 a RF-5) ---------- *@
                    <div class="live-quote mb-2">
                        @if (string.IsNullOrWhiteSpace(company?.Ticker))
                        {
                            <span class="text-muted"><i class="bi bi-info-circle me-1"></i>Sin ticker: no se puede consultar el precio en vivo.</span>
                        }
                        else if (quote == null)
                        {
                            <span class="text-muted">
                                @if (isRefreshingQuote)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>@("Consultando precio en vivo...")
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle me-1"></i>@("Sin precio en vivo")
                                }
                            </span>
                        }
                        else
                        {
                            <div>
                                <div class="live-quote-meta">Precio de referencia</div>
                                <div class="live-quote-price">@CurrencyFormatter.Format(quote.Price, CurrencyCode)</div>
                            </div>
                            @if (quote.Change.HasValue)
                            {
                                <div class="live-quote-change @(quote.Change.Value >= 0 ? "gain" : "loss")">
                                    <i class="bi @(quote.Change.Value >= 0 ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                    @CurrencyFormatter.Format(quote.Change.Value, CurrencyCode)
                                    (@(quote.ChangePercent?.ToString("+0.00;-0.00;0.00"))&nbsp;%)
                                </div>
                            }
                            <div class="live-quote-meta">
                                <div>Máx. <strong>@(quote.DayHigh.HasValue ? CurrencyFormatter.Format(quote.DayHigh.Value, CurrencyCode) : "N/D")</strong></div>
                                <div>Mín. <strong>@(quote.DayLow.HasValue ? CurrencyFormatter.Format(quote.DayLow.Value, CurrencyCode) : "N/D")</strong></div>
                            </div>
                            <div class="live-quote-meta">
                                <div><span class="market-badge @MarketBadgeClass">@MarketLabel</span></div>
                                <div>Precio de las @(quote.PriceTime?.ToString("HH:mm") ?? "--:--") · @quote.Symbol</div>
                            </div>
                        }

                        <div class="live-quote-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="Actualizar precio"
                                    disabled="@(isRefreshingQuote || string.IsNullOrWhiteSpace(company?.Ticker))"
                                    @onclick="RefreshQuoteNowAsync">
                                <i class="bi bi-arrow-clockwise @(isRefreshingQuote ? "spin" : "")"></i>
                                Actualizar precio
                            </button>
                            <button type="button" class="btn btn-sm btn-trade-buy"
                                    disabled="@(quote == null || isSaving)"
                                    title="@(quote == null ? "Sin precio en vivo" : "Comprar")"
                                    @onclick="@(() => OpenTradeForm("Compra"))">
                                <i class="bi bi-plus-circle me-1"></i>Comprar
                            </button>
                            <button type="button" class="btn btn-sm btn-trade-sell"
                                    disabled="@(quote == null || availableShares <= 0 || isSaving)"
                                    title="@(quote == null ? "Sin precio en vivo" : availableShares <= 0 ? "No tienes acciones de esta empresa" : "Vender")"
                                    @onclick="@(() => OpenTradeForm("Venta"))">
                                <i class="bi bi-dash-circle me-1"></i>Vender
                            </button>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        Precio único de referencia: Yahoo no facilita precio de compra y de venta separados.
                        @if (quote != null && availableShares <= 0)
                        {
                            <span class="ms-1">· No tienes acciones de esta empresa para vender.</span>
                        }
                    </div>

                    @if (quoteFailed && quote != null)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">
                            <i class="bi bi-wifi-off me-1"></i>
                            No se pudo actualizar · último precio de @(quote.PriceTime?.ToString("HH:mm") ?? lastQuoteAt?.ToString("HH:mm") ?? "--:--")
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible py-2 small mb-2">
                            <i class="bi bi-check-circle-fill me-1"></i>@successMessage
                            <button type="button" class="btn-close btn-sm" @onclick="() => successMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }

                    @* ---------- Mini-formulario de operación (RF-6 a RF-11) ---------- *@
                    @if (tradeType != null)
                    {
                        <div class="trade-form mb-3 @(tradeType == "Compra" ? "buy" : "sell")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@(tradeType == "Compra" ? "Comprar" : "Vender") @company?.Name</strong>
                                @if (tradeType == "Venta")
                                {
                                    <span class="small text-muted">Acciones disponibles: <strong>@ShareQuantity.Format(availableShares)</strong></span>
                                }
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" class="form-control form-control-sm"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           @bind="tradeDate" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Acciones</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control form-control-sm"
                                           inputmode="decimal" @bind="tradeShares" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Precio por acción</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control form-control-sm"
                                           @bind="tradePrice" @bind:after="RoundTradePrice" @oninput="StopFollowingLivePrice" />
                                    @if (followLivePrice)
                                    {
                                        <small class="text-muted"><i class="bi bi-broadcast me-1"></i>Sigue al precio en vivo</small>
                                    }
                                    else if (quote != null)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="FollowLivePriceAgain">Volver al precio en vivo</button>
                                    }
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Comisión</label>
                                    <input type="number" min="0" step="0.01" class="form-control form-control-sm"
                                           @bind="tradeCommission" />
                                </div>
                                @if (!IsBaseCurrency)
                                {
                                    <div class="col-6 col-md-2">
                                        <label class="form-label">Tipo a @baseCurrencyCode</label>
                                        <input type="number" min="0" step="0.000001" class="form-control form-control-sm"
                                               placeholder="Sin tipo"
                                               @bind="tradeExchangeRate" />
                                    </div>
                                }
                                @if (tradeBankAccounts.Count > 0)
                                {
                                    @* Cuenta del movimiento: ingreso de la venta (SPEC-02-04) o gasto de la compra (SPEC-02-06); vacía = la más antigua *@
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Cuenta bancaria</label>
                                        <select class="form-select form-select-sm" @bind="tradeBankAccountName">
                                            <option value="">Por defecto: @defaultTradeBankAccountName</option>
                                            @if (tradeType == "Compra")
                                            {
                                                <option value="@OperationAmountCalculator.NoBankMovementValue">No registrar en banco</option>
                                            }
                                            @foreach (var account in tradeBankAccounts)
                                            {
                                                <option value="@account.Name">@account.Name</option>
                                            }
                                        </select>
                                    </div>
                                }
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Importe total</label>
                                    <div class="trade-form-amount">
                                        @(TradeAmount.HasValue ? CurrencyFormatter.Format(TradeAmount.Value, CurrencyCode) : "—")
                                    </div>
                                </div>
                            </div>

                            @if (TradeBlockReason != null)
                            {
                                <div class="text-danger small mt-2"><i class="bi bi-lock-fill me-1"></i>@TradeBlockReason</div>
                            }
                            else if (marketState == MarketState.Unknown && tradeDate.Date == DateTime.Today)
                            {
                                <div class="text-warning small mt-2"><i class="bi bi-question-circle me-1"></i>No se pudo saber si el mercado está abierto.</div>
                            }

                            @if (!string.IsNullOrEmpty(tradeError))
                            {
                                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@tradeError</div>
                            }

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelTrade" disabled="@isSaving">Cancelar</button>
                                <button type="button"
                                        class="btn btn-sm @(tradeType == "Compra" ? "btn-trade-buy" : "btn-trade-sell")"
                                        disabled="@(isSaving || TradeBlockReason != null || !TradeAmount.HasValue)"
                                        @onclick="ConfirmTradeAsync">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    @(tradeType == "Compra" ? "Confirmar compra" : "Confirmar venta")
                                </button>
                            </div>
                        </div>
                    }

                    @* ---------- Controles del gráfico ---------- *@
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="chart-layers">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"{chartElementId}-avg")"
                                       checked="@preferences.ShowAverage"
                                       disabled="@(isLoadingChart || !HasPosition || IsComparing)"
                                       @onchange="e => ToggleLayerAsync(LayerAverage, (bool)e.Value!)" />
                                <label class="form-check-label" for="@($"{chartElementId}-avg")">Precio medio y resultado</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"{chartElementId}-candles")"
                                       checked="@preferences.ShowCandles"
                                       disabled="@(isLoadingChart || IsComparing)"
                                       @onchange="e => ToggleLayerAsync(LayerCandles, (bool)e.Value!)" />
                                <label class="form-check-label" for="@($"{chartElementId}-candles")">Velas</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"{chartElementId}-volume")"
                                       checked="@preferences.ShowVolume"
                                       disabled="@(isLoadingChart || IsComparing)"
                                       @onchange="e => ToggleLayerAsync(LayerVolume, (bool)e.Value!)" />
                                <label class="form-check-label" for="@($"{chartElementId}-volume")">Volumen</label>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"{chartElementId}-marks")"
                                       checked="@preferences.ShowMarks"
                                       disabled="@isLoadingChart"
                                       @onchange="e => ToggleLayerAsync(LayerMarks, (bool)e.Value!)" />
                                <label class="form-check-label" for="@($"{chartElementId}-marks")">Marcas</label>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @* Comparación con otra empresa o un índice (SPEC-05-04, RF-3) *@
                            @if (IsComparing)
                            {
                                <button type="button" class="btn btn-sm btn-compare"
                                        title="Volver al gráfico normal"
                                        disabled="@(isLoadingChart || isLoadingComparison)"
                                        @onclick="ClearComparisonAsync">
                                    <i class="bi bi-x-lg me-1"></i>Quitar comparación
                                </button>
                            }
                            else if (comparePickerOpen)
                            {
                                <select class="form-select form-select-sm compare-select"
                                        disabled="@(isLoadingChart || isLoadingComparison)"
                                        @onchange="OnCompareSelectedAsync">
                                    <option value="">Comparar con…</option>
                                    @if (compareCompanies.Count > 0)
                                    {
                                        <optgroup label="Empresas">
                                            @foreach (var other in compareCompanies)
                                            {
                                                <option value="@($"C:{other.Id}")">@other.Name (@other.Ticker)</option>
                                            }
                                        </optgroup>
                                    }
                                    @if (compareIndices.Count > 0)
                                    {
                                        <optgroup label="Índices">
                                            @foreach (var index in compareIndices)
                                            {
                                                <option value="@($"I:{index.Id}")">@index.Name (@index.Symbol)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Cerrar el selector" @onclick="() => comparePickerOpen = false">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-compare"
                                        title="Superponer otra empresa o un índice en base 100"
                                        disabled="@(company == null || isLoadingChart || chartError != null)"
                                        @onclick="OpenComparePickerAsync">
                                    <i class="bi bi-intersect me-1"></i>Comparar
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-chart-mark"
                                    title="Añadir una marca con fecha y descripción sobre el gráfico"
                                    disabled="@(company == null || isSavingMark)"
                                    @onclick="() => OpenMarkForm(null)">
                                <i class="bi bi-bookmark-plus me-1"></i>Añadir marca
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="Volver a descargar el histórico de Yahoo Finance aunque la caché sea reciente"
                                    disabled="@isLoadingChart"
                                    @onclick="ReloadHistoryAsync">
                                <i class="bi bi-cloud-download me-1"></i>Recargar histórico
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="Volver al tramo inicial de la temporalidad"
                                    disabled="@(isLoadingChart || chartError != null)"
                                    @onclick="ResetViewAsync">
                                <i class="bi bi-arrows-angle-contract me-1"></i>Vista inicial
                            </button>
                            @* Temporalidades de más fina a más gruesa (SPEC-05-02, RF-6) *@
                            <div class="btn-group" role="group">
                                @foreach (var option in GranularityOptions)
                                {
                                    <button type="button" class="btn btn-sm @(granularity == option.Value ? "btn-primary" : "btn-outline-primary")"
                                            disabled="@isLoadingChart"
                                            @onclick="() => ChangeGranularityAsync(option.Value)">
                                        @option.Label
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @* ---------- Formulario de marca (SPEC-05-03, RF-8 y RF-12) ---------- *@
                    @if (markFormOpen)
                    {
                        <div class="mark-form mb-3">
                            <strong class="d-block mb-2">@(editingMarkId.HasValue ? "Editar marca" : "Añadir marca")</strong>
                            <div class="row g-2 align-items-end">
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" class="form-control form-control-sm"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           @bind="markInput.Date" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Descripción</label>
                                    <input type="text" class="form-control form-control-sm" maxlength="200"
                                           placeholder="p. ej. Resultados del tercer trimestre"
                                           @bind="markInput.Description" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label d-block">Tipo</label>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="@($"{chartElementId}-marktype")" id="@($"{chartElementId}-marktype-company")"
                                               checked="@(!markInput.IsGlobal)" @onchange="() => markInput.IsGlobal = false" />
                                        <label class="form-check-label" for="@($"{chartElementId}-marktype-company")">Empresa</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="@($"{chartElementId}-marktype")" id="@($"{chartElementId}-marktype-global")"
                                               checked="@markInput.IsGlobal" @onchange="() => markInput.IsGlobal = true" />
                                        <label class="form-check-label" for="@($"{chartElementId}-marktype-global")">Global (todas las empresas)</label>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(markError))
                            {
                                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@markError</div>
                            }
                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelMarkForm" disabled="@isSavingMark">Cancelar</button>
                                <button type="button" class="btn btn-sm btn-chart-mark" @onclick="SaveMarkAsync" disabled="@isSavingMark">
                                    @if (isSavingMark)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Guardar marca
                                </button>
                            </div>
                        </div>
                    }

                    @if (preferences.ShowAverage && HasPosition && company != null && !IsComparing)
                    {
                        <div class="position-summary mb-2">
                            <span>Acciones <strong>@ShareQuantity.Format(company.NumberOfShares)</strong></span>
                            <span>Precio medio <strong>@(company.AveragePurchasePrice.HasValue ? CurrencyFormatter.Format(company.AveragePurchasePrice.Value, CurrencyCode) : "N/D")</strong></span>
                            <span>Invertido <strong>@CurrencyFormatter.Format(company.TotalInvestedInitial, CurrencyCode)</strong></span>
                            <span>Valor actual <strong>@CurrencyFormatter.Format(company.TotalInvestedValue, CurrencyCode)</strong></span>
                            <span class="@(UnrealizedResult >= 0 ? "text-success" : "text-danger")">
                                Resultado <strong>@CurrencyFormatter.Format(UnrealizedResult, CurrencyCode) (@(company.CalculatePlusvaliaReturnPercent().ToString("+0.00;-0.00;0.00"))&nbsp;%)</strong>
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(historyWarning))
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@historyWarning
                        </div>
                    }

                    @* Descarga del histórico antiguo en segundo plano (SPEC-05-02, RF-4, RF-5 y RF-9) *@
                    @foreach (var message in new[] { backfillMessage, hourlyBackfillMessage })
                    {
                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert alert-info py-1 px-2 small mb-2">
                                <span class="spinner-border spinner-border-sm me-1"></span>@message
                            </div>
                        }
                    }
                    @* Comparación (SPEC-05-04): carga de la serie comparada y avisos *@
                    @if (isLoadingComparison)
                    {
                        <div class="alert alert-info py-1 px-2 small mb-2">
                            <span class="spinner-border spinner-border-sm me-1"></span>@comparisonLoadingMessage
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(comparisonWarning))
                    {
                        <div class="alert alert-warning alert-dismissible py-1 px-2 small mb-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>@comparisonWarning
                            <button type="button" class="btn-close btn-sm" @onclick="() => comparisonWarning = null" aria-label="Cerrar"></button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(comparedBackfillMessage))
                    {
                        <div class="alert alert-info py-1 px-2 small mb-2">
                            <span class="spinner-border spinner-border-sm me-1"></span>@comparedBackfillMessage
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(backfillError))
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">
                            <i class="bi bi-cloud-slash me-1"></i>@backfillError
                        </div>
                    }

                    @if (isLoadingChart)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-secondary"></div>
                            <p class="mt-3 text-muted">Cargando cotización...</p>
                        </div>
                    }
                    else if (chartError != null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@chartError
                        </div>
                    }

                    <div id="@chartElementId" style="@(isLoadingChart || chartError != null ? "display:none;" : "")"></div>
                    <div id="@volumeElementId" style="@(isLoadingChart || chartError != null || !preferences.ShowVolume ? "display:none;" : "")"></div>
                    @* Minigráfico navegador: todo el histórico y el tramo futuro (SPEC-21-01, RF-10) *@
                    <div id="@navigatorElementId" class="company-chart-navigator" style="@(isLoadingChart || chartError != null ? "display:none;" : "")"></div>

                    @if (!isLoadingChart && chartError == null && IsComparing)
                    {
                        @* Leyenda y cifras del tramo visible (SPEC-05-04, RF-4 y RF-6) *@
                        <div class="chart-comparison-panel mt-1">
                            <span class="chart-comparison-item">
                                <span class="chart-legend-dot comparison-main"></span>@company?.Name
                                <strong class="@ReturnCss(comparison?.MainReturnPercent)">@FormatReturn(comparison?.MainReturnPercent)</strong>
                            </span>
                            <span class="chart-comparison-item">
                                <span class="chart-legend-dot comparison-compared"></span>@comparedSeries!.Name
                                <strong class="@ReturnCss(comparison?.ComparedReturnPercent)">@FormatReturn(comparison?.ComparedReturnPercent)</strong>
                            </span>
                            <span class="chart-comparison-item">
                                @if (comparison?.Correlation is decimal correlation)
                                {
                                    @("Correlación")<strong class="ms-1">@correlation.ToString("0.00")</strong><span class="ms-1">(@comparison.CorrelationLabel)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Pocos datos para calcular la correlación</span>
                                }
                            </span>
                            @if (ComparisonRangeLabel != null)
                            {
                                <span class="chart-comparison-item text-muted">@ComparisonRangeLabel</span>
                            }
                            @if (preferences.ShowMarks)
                            {
                                <span class="chart-legend-item is-static"><span class="chart-legend-dot mark"></span>Marca</span>
                                <span class="chart-legend-item is-static"><span class="chart-legend-dot mark-global"></span>Marca global</span>
                            }
                        </div>
                        <div class="small text-muted mt-1">
                            Base 100 en el primer periodo visible. Rentabilidad y correlación (de las rentabilidades de cada periodo) del tramo visible.
                        </div>
                    }
                    else if (!isLoadingChart && chartError == null)
                    {
                        @* Pulsar un tipo de operación lo oculta o lo muestra (SPEC-05-03, RF-7); las marcas van con su interruptor *@
                        <div class="chart-legend mt-1">
                            @foreach (var item in LegendItems)
                            {
                                <button type="button" class="chart-legend-item @(hiddenKinds.Contains(item.Kind) ? "is-hidden" : "")"
                                        title="@(hiddenKinds.Contains(item.Kind) ? "Mostrar" : "Ocultar") @item.Label.ToLowerInvariant() en el gráfico"
                                        @onclick="() => ToggleLegendKindAsync(item.Kind)">
                                    <span class="chart-legend-dot @item.Css"></span>@item.Label
                                </button>
                            }
                            <span class="chart-legend-item is-static"><span class="chart-legend-dot mark"></span>Marca</span>
                            <span class="chart-legend-item is-static"><span class="chart-legend-dot mark-global"></span>Marca global</span>
                            <span class="chart-legend-item is-static" title="Hueco: pendiente · Relleno: cobrado"><span class="chart-legend-dot dividend-payment"></span>Pago de dividendo</span>
                        </div>
                    }

                    @* ---------- Panel de marcas (SPEC-05-03, RF-12) ---------- *@
                    <div class="chart-marks-panel mt-2">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => marksPanelOpen = !marksPanelOpen">
                            <i class="bi @(marksPanelOpen ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>Marcas (@marks.Count)
                        </button>
                        @if (marksPanelOpen)
                        {
                            @if (!string.IsNullOrEmpty(markPanelError))
                            {
                                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@markPanelError</div>
                            }
                            @if (marks.Count == 0)
                            {
                                <div class="small text-muted mt-1">No hay marcas. Usa «Añadir marca» para crear una.</div>
                            }
                            else
                            {
                                <table class="table table-sm align-middle mt-1 mb-0 chart-marks-table">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Tipo</th>
                                            <th>Descripción</th>
                                            <th class="text-center">Activa</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mark in marks)
                                        {
                                            <tr class="@(mark.IsActive ? "" : "text-muted")">
                                                <td class="text-nowrap">@mark.Date.ToString("dd/MM/yyyy")</td>
                                                <td><span class="mark-type @(mark.IsGlobal ? "global" : "company")">@(mark.IsGlobal ? "Global" : "Empresa")</span></td>
                                                <td>@mark.Description</td>
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-inline-block mb-0">
                                                        <input class="form-check-input" type="checkbox" checked="@mark.IsActive"
                                                               title="@(mark.IsActive ? "Desactivar" : "Activar") la marca"
                                                               @onchange="e => SetMarkActiveAsync(mark, (bool)e.Value!)" />
                                                    </div>
                                                </td>
                                                <td class="text-end text-nowrap">
                                                    @if (confirmDeleteMarkId == mark.Id)
                                                    {
                                                        <span class="small me-1">@(mark.IsGlobal ? "Se borrará en todas las empresas. ¿Borrar?" : "¿Borrar la marca?")</span>
                                                        <button type="button" class="btn btn-sm btn-danger py-0" @onclick="() => DeleteMarkAsync(mark.Id)">Sí</button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="() => confirmDeleteMarkId = null">No</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link py-0" title="Editar" @onclick="() => OpenMarkForm(mark)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-link text-danger py-0" title="Borrar" @onclick="() => confirmDeleteMarkId = mark.Id">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Se lanza al cerrar el modal. El parámetro indica si se registró alguna operación (para recargar la lista).
    /// </summary>
    [Parameter] public EventCallback<bool> OnClosed { get; set; }

    private static readonly TimeSpan LiveRefreshInterval = TimeSpan.FromSeconds(30);
    private const string LayerAverage = "average";
    private const string LayerCandles = "candles";
    private const string LayerVolume = "volume";
    private const string LayerMarks = "marks";

    // Leyenda que filtra los tipos de operación (SPEC-05-03, RF-7): se vacía al abrir el modal
    private static readonly (string Kind, string Css, string Label)[] LegendItems =
    {
        ("Buy", "buy", "Compra"),
        ("Sell", "sell", "Venta"),
        ("Dividend", "dividend", "Dividendo"),
        ("Transfer", "transfer", "Traspaso")
    };
    private readonly HashSet<string> hiddenKinds = new();

    // Marcas del gráfico (SPEC-05-03): de la empresa y globales, activas e inactivas
    private List<ChartMark> marks = new();
    private bool markFormOpen;
    private int? editingMarkId;
    private ChartMarkInput markInput = new();
    private string? markError;
    private bool isSavingMark;
    private bool marksPanelOpen;
    private int? confirmDeleteMarkId;
    private string? markPanelError;

    /// <summary>Tramo visible del gráfico en milisegundos (companyChart.getView)</summary>
    private sealed class ChartView
    {
        public long? Start { get; set; }
        public long? End { get; set; }
    }

    private readonly string chartElementId = $"company-chart-{Guid.NewGuid():N}";
    private string volumeElementId => chartElementId + "-volume";
    private string navigatorElementId => chartElementId + "-nav";

    // El modal usa el mismo DbContext que el resto de la app. Antes tenía uno propio y eso dejaba
    // datos desfasados en el contexto principal: una venta hecha desde el gráfico y deshecha luego en
    // «Histórico de ventas» no reabría las compras (EF no veía cambios sobre sus copias antiguas).
    // Mientras el modal está abierto nadie más consulta datos; el semáforo serializa los accesos del modal.
    private bool isActive;

    // Serializa todo acceso a datos del modal: temporizador, botones y guardado nunca coinciden (RF-14)
    private readonly SemaphoreSlim dataLock = new(1, 1);
    private CancellationTokenSource? liveCts;

    // Descargas en segundo plano (SPEC-05-02): histórico diario antiguo y barras de una hora
    private CancellationTokenSource? backfillCts;
    private CancellationTokenSource? hourlyCts;
    private bool isBackfilling;
    private int backfillRun; // cambia en cada arranque o cancelación: un bucle antiguo no toca el estado del nuevo
    private string? backfillMessage;
    private string? hourlyBackfillMessage;
    private string? backfillError;

    private static readonly (ChartGranularity Value, string Label)[] GranularityOptions =
    {
        (ChartGranularity.Hourly, "Horas"),
        (ChartGranularity.Daily, "Diario"),
        (ChartGranularity.Weekly, "Semanal"),
        (ChartGranularity.Monthly, "Mensual"),
        (ChartGranularity.Yearly, "Anual")
    };

    private bool isVisible;
    private bool isLoadingChart;
