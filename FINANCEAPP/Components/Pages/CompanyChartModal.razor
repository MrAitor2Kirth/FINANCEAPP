    /// <summary>
    /// Abre el selector con las otras empresas (con ticker) y los índices dados de alta (RF-3)
    /// </summary>
    private async Task OpenComparePickerAsync()
    {
        if (company == null)
        {
            return;
        }

        comparisonWarning = null;
        await RunExclusiveAsync(async () =>
        {
            var companies = await CompanyService.GetAllAsync();
            compareCompanies = companies
                .Where(c => c.Id != company.Id && !string.IsNullOrWhiteSpace(c.Ticker))
                .OrderBy(c => c.Name)
                .ToList();
            compareIndices = await BenchmarkIndexService.GetAllAsync();
        });

        if (compareCompanies.Count == 0 && compareIndices.Count == 0)
        {
            comparisonWarning = "No hay otras empresas con ticker ni índices para comparar. Da de alta índices en «Índices».";
            return;
        }

        comparePickerOpen = true;
    }

    private async Task OnCompareSelectedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value) || value.Length < 3 || !int.TryParse(value[2..], out var id))
        {
            return;
        }

        ChartSeriesRef? series = null;
        if (value.StartsWith("C:"))
        {
            var other = compareCompanies.FirstOrDefault(c => c.Id == id);
            if (other != null)
            {
                series = ChartSeriesRef.ForCompany(other.Id, other.Ticker!, other.Name);
            }
        }
        else
        {
            var index = compareIndices.FirstOrDefault(i => i.Id == id);
            if (index != null)
            {
                series = ChartSeriesRef.ForBenchmark(index.Id, index.Symbol, index.Name);
            }
        }

        if (series != null)
        {
            await StartComparisonAsync(series);
        }
    }

    /// <summary>
    /// Carga la serie elegida (de la caché o de Yahoo si no la hay), la superpone en base 100 con el tramo que se estaba
    /// mirando y, si su histórico no está completo, lo completa detrás del de la empresa (RF-2 a RF-4)
    /// </summary>
    private async Task StartComparisonAsync(ChartSeriesRef series)
    {
        comparePickerOpen = false;
        comparisonWarning = null;
        CancelComparedBackfill();
        isLoadingComparison = true;
        comparisonLoadingMessage = $"Cargando {series.Name}…";
        StateHasChanged();

        var view = await GetChartViewAsync();
        var loaded = await LoadComparedPointsAsync(series, allowDownload: true, CancellationToken.None);
        isLoadingComparison = false;

        if (!isActive)
        {
            return;
        }

        if (!loaded)
        {
            StateHasChanged();
            return;
        }

        comparedSeries = series;
        await RenderChartAsync(view);
        StartComparedBackfill(series);
    }

    private async Task ClearComparisonAsync()
    {
        var view = await GetChartViewAsync();
        ResetComparison();

        // Vuelven velas, volumen, operaciones y dividendos en el mismo tramo (RF-4b)
        await RenderChartAsync(view);
    }

    /// <summary>
    /// Puntos de la serie comparada en la temporalidad activa: barras de una hora en memoria en Horas; el resto, del
    /// histórico guardado (con <paramref name="allowDownload"/>, de Yahoo si está vacío o tiene más de 12 horas).
    /// Devuelve false (con aviso) si no hay datos.
    /// </summary>
    private async Task<bool> LoadComparedPointsAsync(ChartSeriesRef series, bool allowDownload, CancellationToken token)
    {
        try
        {
            PriceHistoryResult? result = null;
            if (granularity == ChartGranularity.Hourly)
            {
                result = await PriceHistoryService.GetSeriesHourlyAsync(series, token);
            }
            else
            {
                await RunExclusiveAsync(async () =>
                {
                    result = allowDownload
                        ? await PriceHistoryService.GetSeriesHistoryWithStatusAsync(series, granularity, false)
                        : await PriceHistoryService.GetCachedSeriesHistoryAsync(series, granularity);
                });
            }

            if (result == null || result.Points.Count == 0)
            {
                comparisonWarning = HasInternet()
                    ? $"No hay cotización de {series.Name} en Yahoo Finance para esta temporalidad; se muestra la empresa sola."
                    : $"Sin conexión a Internet: no se pudo cargar {series.Name}.";
                return false;
            }

            comparedPoints = result.Points;
            return true;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar la serie comparada {Series}", series.Name);
            comparisonWarning = $"No se pudo cargar {series.Name}; se muestra la empresa sola.";
            return false;
        }
    }

    /// <summary>
    /// Al cambiar de temporalidad o recargar, la serie comparada se lee en la misma temporalidad (RF-5). Si no tiene
    /// datos en ella, se quita la comparación con un aviso.
    /// </summary>
    private async Task LoadComparedForGranularityAsync(CancellationToken token)
    {
        var series = comparedSeries;
        if (series == null)
        {
            return;
        }

        // El tramo de la nueva temporalidad es el inicial: la base se calcula en él
        comparisonStartMs = viewStart.HasValue ? ToMs(viewStart.Value) : null;
        comparisonEndMs = viewEnd.HasValue ? ToMs(viewEnd.Value) : null;

        // Con la caché vacía (se empezó a comparar en Horas) o de más de 12 horas, se descarga como al comparar
        if (!await LoadComparedPointsAsync(series, allowDownload: true, token))
        {
            ResetComparison();
            comparisonWarning ??= $"No hay cotización de {series.Name} para esta temporalidad.";
            return;
        }

        if (granularity != ChartGranularity.Hourly && !isComparedBackfilling)
        {
            StartComparedBackfill(series);
        }
    }

    /// <summary>
    /// Alinea la serie comparada con los periodos de la empresa y calcula base 100, rentabilidades y correlación del
    /// tramo visible con <see cref="ChartComparison"/> (RF-4 a RF-6)
    /// </summary>
    private void RecalculateComparison()
    {
        if (comparedSeries == null || points.Count == 0)
        {
            comparison = null;
            return;
        }

        var aligned = ChartComparison.Align(points, comparedPoints);
        var mainCloses = points.Select(p => (decimal?)p.Close).ToList();

        var startIndex = 0;
        var endIndex = points.Count - 1;
        if (comparisonStartMs.HasValue)
        {
            var i = points.FindIndex(p => ToMs(p.Date) >= comparisonStartMs.Value);
            startIndex = i < 0 ? points.Count - 1 : i;
        }

        if (comparisonEndMs.HasValue)
        {
            endIndex = points.FindLastIndex(p => ToMs(p.Date) <= comparisonEndMs.Value);
            if (endIndex < startIndex)
            {
                endIndex = startIndex;
            }
        }

        comparison = ChartComparison.Compute(mainCloses, aligned, startIndex, endIndex);
        comparisonRange = (points[startIndex].Date, points[endIndex].Date);
    }

    private (DateTime Start, DateTime End)? comparisonRange;

    private string? ComparisonRangeLabel => comparisonRange == null
        ? null
        : $"Del {FormatPeriod(comparisonRange.Value.Start)} al {FormatPeriod(comparisonRange.Value.End)}";

    private string FormatPeriod(DateTime date) => granularity switch
    {
        ChartGranularity.Hourly => date.ToString("dd/MM/yyyy HH:mm"),
        ChartGranularity.Monthly => date.ToString("MM/yyyy"),
        ChartGranularity.Yearly => date.ToString("yyyy"),
        _ => date.ToString("dd/MM/yyyy")
    };

    private static string FormatReturn(decimal? percent) => percent.HasValue
        ? percent.Value.ToString("+0.00;-0.00;0.00") + " %"
        : "—";

    private static string ReturnCss(decimal? percent) => percent switch
    {
        > 0 => "text-success",
        < 0 => "text-danger",
        _ => string.Empty
    };

    /// <summary>
    /// Datos de la comparación para el JS (null sin comparación): nombres y las dos series en base 100
    /// </summary>
    private object? BuildComparisonPayload()
    {
        if (comparedSeries == null)
        {
            return null;
        }

        RecalculateComparison();
        return new
        {
            mainName = company?.Name ?? string.Empty,
            comparedName = comparedSeries.Name,
            main = comparison?.Main ?? new List<decimal?>(),
            compared = comparison?.Compared ?? new List<decimal?>()
        };
    }

    /// <summary>
    /// El gráfico avisa del tramo visible (con una espera de 250 ms) al hacer zoom, desplazarse o mover el navegador:
    /// se recalcula la base 100 en el nuevo primer periodo, rentabilidades y correlación (RF-4 y RF-6)
    /// </summary>
    [JSInvokable]
    public async Task OnComparisonRangeChanged(long startMs, long endMs)
    {
        if (comparedSeries == null || !isVisible)
        {
            return;
        }

        comparisonStartMs = startMs;
        comparisonEndMs = endMs;
        RecalculateComparison();
        if (comparison == null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("companyChart.setComparison", chartElementId,
                JsonSerializer.Serialize(new { main = comparison.Main, compared = comparison.Compared }));
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "No se pudo redibujar la comparación");
        }

        StateHasChanged();
    }

    private void StartComparedBackfill(ChartSeriesRef series)
    {
        CancelComparedBackfill();
        comparedBackfillCts = new CancellationTokenSource();
        isComparedBackfilling = true;
        _ = ComparedBackfillLoopAsync(series, comparedBackfillCts.Token);
    }

    /// <summary>
    /// Completa hacia atrás el histórico diario de la serie comparada, después del de la empresa abierta (D11): mismos
    /// bloques de 10 años, descarga fuera del semáforo y guardado dentro. Cada bloque amplía la comparación sin mover la vista.
    /// </summary>
    private async Task ComparedBackfillLoopAsync(ChartSeriesRef series, CancellationToken token)
    {
        try
        {
            // Primero el histórico de la empresa abierta
            if (backfillTask != null)
            {
                await backfillTask;
            }

            HistoryBackfillState? state = null;
            await RunExclusiveAsync(async () => state = await PriceHistoryService.GetSeriesBackfillStateAsync(series));
            if (state == null || state.IsComplete || state.OldestDate == null)
            {
                return;
            }

            var cursor = state.OldestDate.Value;
            var oldestShown = cursor;
            while (!token.IsCancellationRequested && comparedSeries == series)
            {
                comparedBackfillMessage = $"Descargando histórico anterior de {series.Name}… (desde {oldestShown.Year})";
                await InvokeAsync(StateHasChanged);

                var block = await PriceHistoryService.FetchOlderDailyBlockAsync(series.Symbol, cursor, token);
                if (token.IsCancellationRequested || comparedSeries != series)
                {
                    return;
                }

                if (block.Failed)
                {
                    backfillError = $"No se pudo descargar el histórico anterior de {series.Name}; se reintentará en la próxima comparación.";
                    return;
                }

                var saved = false;
                var reloaded = false;
                await RunExclusiveAsync(async () =>
                {
                    await PriceHistoryService.SaveSeriesDailyBlockAsync(series, block);
                    saved = true;

                    if (granularity != ChartGranularity.Hourly && !isLoadingChart && comparedSeries == series)
                    {
                        var result = await PriceHistoryService.GetCachedSeriesHistoryAsync(series, granularity);
                        comparedPoints = result.Points;
                        reloaded = true;
                    }
                });

                if (!saved || token.IsCancellationRequested)
                {
                    return;
                }

                if (reloaded)
                {
                    await InvokeAsync(UpdateChartDataAsync);
                }

                if (block.ReachedStart)
                {
                    return;
                }

                cursor = block.BlockStart;
                if (block.OldestDate.HasValue)
                {
                    oldestShown = block.OldestDate.Value;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Comparación quitada o modal cerrado: lo guardado se queda
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al descargar el histórico anterior de {Series}", series.Name);
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isComparedBackfilling = false;
                comparedBackfillMessage = null;
            }

            if (isVisible)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

