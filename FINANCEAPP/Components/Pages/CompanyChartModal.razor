@using System.Text.Json
@inject IPriceHistoryService PriceHistoryService
@inject IOperationService OperationService
@inject IJSRuntime JS

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>
                        Cotización de @company?.Name (@company?.Ticker)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-end mb-3">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm @(granularity == ChartGranularity.Daily ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => ChangeGranularity(ChartGranularity.Daily)">
                                Diario
                            </button>
                            <button type="button" class="btn btn-sm @(granularity == ChartGranularity.Monthly ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => ChangeGranularity(ChartGranularity.Monthly)">
                                Mensual
                            </button>
                            <button type="button" class="btn btn-sm @(granularity == ChartGranularity.Yearly ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => ChangeGranularity(ChartGranularity.Yearly)">
                                Anual
                            </button>
                        </div>
                    </div>

                    @if (isLoadingChart)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-secondary"></div>
                            <p class="mt-3 text-muted">Cargando cotización...</p>
                        </div>
                    }
                    else if (!hasData)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            No se pudo obtener el histórico de cotización para este ticker.
                        </div>
                    }

                    <div id="@chartElementId" style="@(isLoadingChart || !hasData ? "display:none;" : "")"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible = false;
    private bool isLoadingChart = false;
    private bool hasData = false;
    private CompanyDetail? company;
    private ChartGranularity granularity = ChartGranularity.Daily;
    private readonly string chartElementId = $"company-chart-{Guid.NewGuid():N}";

    /// <summary>
    /// Abre el modal y carga el gráfico de cotización para la empresa indicada.
    /// </summary>
    public async Task ShowAsync(CompanyDetail selectedCompany)
    {
        company = selectedCompany;
        granularity = ChartGranularity.Daily;
        isVisible = true;
        await RenderChartAsync();
    }

    private void Close()
    {
        isVisible = false;
        _ = JS.InvokeVoidAsync("companyChart.destroy", chartElementId);
    }

    private async Task ChangeGranularity(ChartGranularity newGranularity)
    {
        if (granularity == newGranularity)
        {
            return;
        }

        granularity = newGranularity;
        await RenderChartAsync();
    }

    private async Task RenderChartAsync()
    {
        if (company == null)
        {
            return;
        }

        isLoadingChart = true;
        StateHasChanged();

        try
        {
            var points = await PriceHistoryService.GetHistoryAsync(company.Id, company.Ticker, granularity);
            var operations = await OperationService.GetByCompanyAsync(company.Name);

            var purchaseOperations = operations
                .Where(o => o.Type.Contains("Compra", StringComparison.OrdinalIgnoreCase))
                .ToList();

            hasData = points.Count > 0;

            if (!hasData)
            {
                return;
            }

            var currentPrice = company.LivePrice ?? company.CurrentPrice;

            var payload = new
            {
                series = points.Select(p => new
                {
                    x = new DateTimeOffset(p.Date).ToUnixTimeMilliseconds(),
                    y = p.Close
                }),
                operations = purchaseOperations.Select(o => new
                {
                    date = new DateTimeOffset(o.Date).ToUnixTimeMilliseconds(),
                    dateLabel = o.Date.ToString("dd/MM/yyyy"),
                    price = o.PricePerShare,
                    shares = o.NumberOfShares
                }),
                currentPrice
            };

            var json = JsonSerializer.Serialize(payload);
            await JS.InvokeVoidAsync("companyChart.render", chartElementId, json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el gráfico de cotización: {ex.Message}");
            hasData = false;
        }
        finally
        {
            isLoadingChart = false;
            StateHasChanged();
        }
    }
}
