@page "/inmuebles"
@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject IPropertyService PropertyService
@inject IPropertyDocumentService DocumentService
@inject NavigationManager Navigation
@inject ILogger<PropertiesList> Logger

<PageTitle>Propiedades e Inmuebles</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="sw" style="--swatch:var(--plum)">Gestión de Propiedades e Inmuebles</h1>
            <p class="text-muted">Administra tus inversiones inmobiliarias y realiza seguimiento de ingresos y gastos</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span> Cargando propiedades...
        </div>
    }
    else if (properties == null || properties.Count == 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> No hay propiedades registradas
            <button class="btn btn-primary ms-3" @onclick="NavigateToNew">
                Registrar primera propiedad
            </button>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-12">
                <button class="btn btn-primary" @onclick="NavigateToNew">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nueva Propiedad
                </button>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card" style="--swatch:var(--plum)">
                <p class="stat-label">Inversión total</p>
                <p class="stat-value">@CurrencyFormatter.Format(totalInvested, null)</p>
            </div>
            <div class="stat-card" style="--swatch:var(--teal)">
                <p class="stat-label">Ingresos</p>
                <p class="stat-value text-success">@CurrencyFormatter.Format(totalIncome, null)</p>
            </div>
            <div class="stat-card" style="--swatch:var(--amber)">
                <p class="stat-label">Gastos</p>
                <p class="stat-value text-danger">@CurrencyFormatter.Format(totalExpenses, null)</p>
            </div>
            <div class="stat-card" style="--swatch:var(--sage)">
                <p class="stat-label">Resultado neto</p>
                <p class="stat-value @(netResult >= 0 ? "text-success" : "text-danger")">@CurrencyFormatter.Format(netResult, null)</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Dirección</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th>Precio Compra</th>
                        <th>Ingresos</th>
                        <th>Gastos</th>
                        <th>Resultado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in properties.OrderByDescending(p => p.CurrentValue))
                    {
                        <tr>
                            <td>
                                <strong>@property.Name</strong>
                                <br />
                                <small class="text-muted">@property.Address</small>
                            </td>
                            <td>@property.PropertyType</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(property.Status)">
                                    @property.Status
                                </span>
                            </td>
                            <td class="text-end">@CurrencyFormatter.Format(property.PurchasePrice, null)</td>
                            <td class="text-end text-success">@CurrencyFormatter.Format(property.TotalIncome, null)</td>
                            <td class="text-end text-danger">@CurrencyFormatter.Format(property.TotalInvested - property.PurchasePrice, null)</td>
                            <td class="text-end fw-bold @(property.NetResult >= 0 ? "text-success" : "text-danger")">
                                @CurrencyFormatter.Format(property.NetResult, null)
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToDetail(property.Id)">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => NavigateToEdit(property.Id)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                @if (property.Status != "Vendida")
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => SellProperty(property.Id)"
                                            title="Vender" aria-label="Vender">
                                        <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProperty(property.Id)">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>

                        @if (expandedPropertyId == property.Id)
                        {
                            <tr class="table-secondary">
                                <td colspan="8">
                                    <div class="p-3">
                                        <h6 class="mb-3">Detalle de Operaciones</h6>
                                        <PropertyOperationsList PropertyName="@property.Name" PropertyService="@PropertyService" OnOperationAdded="@RefreshProperties" />
                                        <PropertyDocumentsPanel PropertyId="@property.Id" PropertyName="@property.Name" OnExpenseCreated="@RefreshProperties" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Property> properties = new();
    private bool isLoading = true;
    private int? expandedPropertyId = null;
    private decimal totalInvested = 0;
    private decimal totalIncome = 0;
    private decimal totalExpenses = 0;
    private decimal netResult = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshProperties();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar propiedades");
        }
    }

    private async Task RefreshProperties()
    {
        isLoading = true;
        try
        {
            properties = await PropertyService.GetAllPropertiesAsync();
            totalInvested = properties.Sum(p => p.TotalInvested);
            totalIncome = properties.Sum(p => p.TotalIncome);
            // Gastos = lo invertido por encima del precio de compra (antes se mostraba el total invertido)
            totalExpenses = properties.Sum(p => p.TotalInvested - p.PurchasePrice);
            netResult = totalIncome - totalInvested;
            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al refrescar propiedades");
            isLoading = false;
        }
    }

    private void NavigateToDetail(int propertyId)
    {
        if (expandedPropertyId == propertyId)
        {
            expandedPropertyId = null;
        }
        else
        {
            expandedPropertyId = propertyId;
        }
    }

    private void NavigateToEdit(int propertyId)
    {
        Navigation.NavigateTo($"/inmuebles/editar/{propertyId}");
    }

    private async Task SellProperty(int propertyId)
    {
        Navigation.NavigateTo($"/inmuebles/vender/{propertyId}");
    }

    private async Task DeleteProperty(int propertyId)
    {
        var documentCount = await DocumentService.CountByPropertyAsync(propertyId);
        var confirmText = documentCount > 0
            ? $"¿Estás seguro de que deseas eliminar esta propiedad? También se eliminarán sus {documentCount} documento(s) adjunto(s) y no se podrán recuperar."
            : "¿Estás seguro de que deseas eliminar esta propiedad?";

        if (await JSRuntime.InvokeAsync<bool>("confirm", confirmText))
        {
            try
            {
                await PropertyService.DeletePropertyAsync(propertyId);
                await RefreshProperties();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error al eliminar propiedad");
            }
        }
    }

    private void NavigateToNew()
    {
        Navigation.NavigateTo("/inmuebles/nueva");
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Alquilado" => "bg-success",
            "Vacío" => "bg-warning",
            "Uso Propio" => "bg-info",
            "En Venta" => "bg-secondary",
            "Vendida" => "bg-danger",
            _ => "bg-dark"
        };
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}
