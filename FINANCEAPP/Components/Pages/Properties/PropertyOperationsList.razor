@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject ILogger<PropertyOperationsList> Logger

@if (operations == null)
{
    <div class="alert alert-info">Cargando operaciones...</div>
}
else if (operations.Count == 0)
{
    <div class="alert alert-warning">No hay operaciones registradas</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var op in operations.OrderByDescending(x => x.Date))
                {
                    <tr>
                        <td>
                            <span class="badge @(op.Category == "Ingreso" ? "bg-success" : "bg-danger")">
                                @op.Category
                            </span>
                        </td>
                        <td>@op.Type</td>
                        <td class="text-end fw-bold">@op.Amount.ToString("C")</td>
                        <td>@op.Description</td>
                        <td>@op.Date.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOperation(op.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <h6>Nueva Operación</h6>
    <div class="row g-2">
        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="newOperation.Category">
                <option value="">Seleccionar categoría...</option>
                <option value="Ingreso">Ingreso</option>
                <option value="Gasto">Gasto</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="newOperation.Type">
                <option value="">Seleccionar tipo...</option>
                @if (newOperation.Category == "Ingreso")
                {
                    <option value="Alquiler">Alquiler</option>
                    <option value="Venta">Venta</option>
                }
                else if (newOperation.Category == "Gasto")
                {
                    <option value="IBI">IBI</option>
                    <option value="Comunidad">Comunidad</option>
                    <option value="Reforma">Reforma</option>
                    <option value="Seguro">Seguro</option>
                    <option value="Hipoteca">Hipoteca</option>
                    <option value="Servicios">Servicios (Agua, Luz, Gas)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" class="form-control form-control-sm" placeholder="Cantidad" 
                   @bind="newOperation.Amount" step="0.01" />
        </div>
        <div class="col-md-2">
            <input type="date" class="form-control form-control-sm" @bind="newOperation.Date" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-sm btn-primary w-100" @onclick="AddOperation">Añadir</button>
        </div>
    </div>
    <div class="row g-2 mt-2">
        <div class="col-12">
            <input type="text" class="form-control form-control-sm" placeholder="Descripción (opcional)" 
                   @bind="newOperation.Description" />
        </div>
    </div>
    @if (!string.IsNullOrEmpty(validationMessage))
    {
        <div class="alert alert-warning mt-2 py-1 px-2 mb-0"><small>@validationMessage</small></div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2 py-1 px-2 mb-0"><small>@errorMessage</small></div>
    }
</div>

@code {
    [Parameter]
    public string PropertyName { get; set; }

    [Parameter]
    public IPropertyService PropertyService { get; set; }

    [Parameter]
    public EventCallback OnOperationAdded { get; set; }

    private List<PropertyOperation> operations = new();
    private PropertyOperation newOperation = new();
    private string validationMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        newOperation.Date = DateTime.Now;
        await LoadOperations();
    }

    private async Task LoadOperations()
    {
        try
        {
            operations = await PropertyService.GetOperationsByPropertyNameAsync(PropertyName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando operaciones");
        }
    }

    private async Task AddOperation()
    {
        validationMessage = string.Empty;
        errorMessage = string.Empty;

        if (string.IsNullOrEmpty(newOperation.Category))
        {
            validationMessage = "Selecciona una categoría.";
            return;
        }
        if (string.IsNullOrEmpty(newOperation.Type))
        {
            validationMessage = "Selecciona un tipo.";
            return;
        }
        if (newOperation.Amount <= 0)
        {
            validationMessage = "La cantidad debe ser mayor que 0.";
            return;
        }

        try
        {
            newOperation.PropertyName = PropertyName;
            await PropertyService.CreateOperationAsync(newOperation);
            newOperation = new() { Date = DateTime.Now };
            await LoadOperations();
            await OnOperationAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error añadiendo operación");
            errorMessage = $"Error al añadir la operación: {ex.Message}";
        }
    }

    private async Task DeleteOperation(int operationId)
    {
        try
        {
            await PropertyService.DeleteOperationAsync(operationId);
            await LoadOperations();
            await OnOperationAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error eliminando operación");
        }
    }
}
