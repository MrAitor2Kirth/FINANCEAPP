@page "/companies/new"
@page "/companies/edit/{Id:int}"
@inject ICompanyService CompanyService
@inject ICountryService CountryService
@inject IMarketCatalogService MarketCatalog
@inject NavigationManager Navigation

<PageTitle>@pageTitle</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="sw" style="--swatch:var(--indigo)">
                <i class="bi @iconClass me-2"></i>
                @pageTitle
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/companies">Empresas</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@breadcrumbText</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-clipboard-data me-2"></i>
                            Datos de la Empresa
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!Id.HasValue)
                        {
                            <!-- Buscador del catálogo de mercado (SPEC-01-04), solo en el alta -->
                            <div class="mb-4">
                                <label for="catalog-search" class="form-label fw-bold">Buscar en el catálogo de mercado</label>
                                <input id="catalog-search"
                                       class="form-control form-control-lg"
                                       placeholder="Nombre o ticker (por ejemplo: acs, santander, AAPL)"
                                       autocomplete="off"
                                       @bind="catalogText"
                                       @bind:event="oninput"
                                       @bind:after="SearchCatalog" />
                                <div class="form-text">
                                    Rellena el nombre, el ticker y el país. Después completa el sector y el precio.
                                    <a href="/settings/market-catalog">Ver el catálogo</a>
                                </div>
                                @if (catalogResults.Count > 0)
                                {
                                    <div class="list-group mt-2">
                                        @foreach (var result in catalogResults)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                    @onclick="() => PickFromCatalog(result.Ticker)">
                                                <span>@result.Name</span>
                                                <span>
                                                    @if (ownedTickers.Contains(result.Ticker.ToUpperInvariant()))
                                                    {
                                                        <span class="badge bg-secondary me-2">Ya en tu lista</span>
                                                    }
                                                    <span class="text-muted">@result.Ticker</span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(catalogError))
                                {
                                    <div class="alert alert-danger mt-2 mb-0" role="alert">@catalogError</div>
                                }
                                @if (!string.IsNullOrEmpty(catalogWarning))
                                {
                                    <div class="alert alert-warning mt-2 mb-0" role="status">@catalogWarning</div>
                                }
                            </div>
                        }

                        <EditForm Model="@company" OnValidSubmit="@HandleValidSubmit">
                            <DataAnnotationsValidator />

                            <!-- Nombre -->
                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold">
                                    Nombre de la Empresa <span class="text-danger">*</span>
                                </label>
                                <InputText id="name" 
                                           class="form-control form-control-lg" 
                                           @bind-Value="company.Name" 
                                           placeholder="Ej: Microsoft Corporation" />
                                <ValidationMessage For="@(() => company.Name)" class="text-danger" />
                            </div>

                            <!-- Ticker -->
                            <div class="mb-3">
                                <label for="ticker" class="form-label fw-bold">
                                    Ticker / Símbolo <span class="text-danger">*</span>
                                </label>
                                <InputText id="ticker" 
                                           class="form-control form-control-lg text-uppercase" 
                                           @bind-Value="company.Ticker" 
                                           placeholder="Ej: MSFT"
                                           maxlength="20" />
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Símbolo de cotización en bolsa (máximo 20 caracteres)
                                </div>
                                <ValidationMessage For="@(() => company.Ticker)" class="text-danger" />
                            </div>

                            <!-- Sector -->
                            <div class="mb-3">
                                <label for="sector" class="form-label fw-bold">
                                    Sector Económico <span class="text-danger">*</span>
                                </label>
                                <InputSelect id="sector" 
                                             class="form-select form-select-lg" 
                                             @bind-Value="company.Sector">
                                    <option value="">-- Seleccione un sector --</option>
                                    <option value="Tecnología">Tecnología</option>
                                    <option value="Salud">Salud</option>
                                    <option value="Financiero">Financiero</option>
                                    <option value="Consumo">Consumo</option>
                                    <option value="Energía">Energía</option>
                                    <option value="Industrial">Industrial</option>
                                    <option value="Telecomunicaciones">Telecomunicaciones</option>
                                    <option value="Utilidades">Utilidades</option>
                                    <option value="Materiales">Materiales</option>
                                    <option value="Inmobiliario">Inmobiliario</option>
                                    <option value="Seguros">Seguros</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => company.Sector)" class="text-danger" />
                            </div>

                            <!-- País (SPEC-01-02) -->
                            <div class="mb-3">
                                <label for="country" class="form-label fw-bold">
                                    País <span class="text-danger">*</span>
                                </label>
                                @if (countries.Count == 0)
                                {
                                    <div class="alert alert-warning mb-0" role="alert">
                                        No hay países en el catálogo. <a href="/settings/countries">Añade uno en Configuración</a> para poder guardar la empresa.
                                    </div>
                                }
                                else
                                {
                                    <InputSelect id="country"
                                                 class="form-select form-select-lg"
                                                 @bind-Value="company.CountryCode">
                                        <option value="">-- Seleccione un país --</option>
                                        @foreach (var country in countries)
                                        {
                                            <option value="@country.Code">@country.Name (@country.Code)</option>
                                        }
                                    </InputSelect>
                                    <div class="form-text">Divisa: <strong>@CurrencyFormatter.Label(currentCurrency)</strong></div>
                                }
                            </div>

                            <div class="row">
                                <!-- Precio Actual -->
                                <div class="col-md-6 mb-3">
                                    <label for="currentPrice" class="form-label fw-bold">
                                        Precio Actual <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">@currencySymbol</span>
                                        <InputNumber id="currentPrice" 
                                                     class="form-control" 
                                                     @bind-Value="company.CurrentPrice" 
                                                     step="0.01"
                                                     placeholder="0.00" />
                                    </div>
                                    <ValidationMessage For="@(() => company.CurrentPrice)" class="text-danger" />
                                </div>

                                <!-- Precio en Vivo -->
                                <div class="col-md-6 mb-3">
                                    <label for="livePrice" class="form-label fw-bold">
                                        Precio en Vivo (Yahoo Finance)
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">@currencySymbol</span>
                                        <InputNumber id="livePrice"
                                                     class="form-control"
                                                     @bind-Value="company.LivePrice"
                                                     step="0.01"
                                                     placeholder="0.00" />
                                    </div>
                                    <ValidationMessage For="@(() => company.LivePrice)" class="text-danger" />
                                    @if (company.LivePriceUpdatedAt.HasValue)
                                    {
                                        <div class="form-text">
                                            <i class="bi bi-clock-history me-1"></i>
                                            Última actualización: @company.LivePriceUpdatedAt.Value.ToString("g")
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <!-- Dividend Yield -->
                                <div class="col-md-6 mb-3">
                                    <label for="dividendYield" class="form-label fw-bold">
                                        Dividend Yield (%)
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <InputNumber id="dividendYield" 
                                                     class="form-control" 
                                                     @bind-Value="company.DividendYield" 
                                                     step="0.01"
                                                     placeholder="0.00" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Rentabilidad por dividendo anual
                                    </div>
                                    <ValidationMessage For="@(() => company.DividendYield)" class="text-danger" />
                                </div>

                                <!-- Próxima fecha de dividendo (SPEC-21-01, RF-5) -->
                                <div class="col-md-6 mb-3">
                                    <label for="nextDividendDate" class="form-label fw-bold">
                                        Próxima fecha de dividendo
                                    </label>
                                    <InputDate id="nextDividendDate"
                                               class="form-control form-control-lg"
                                               @bind-Value="company.NextDividendDate" />
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Fecha de pago. Al guardar con una fecha nueva se crea su línea en
                                        <a href="/dividends">Dividendos</a>; las anteriores no cambian.
                                    </div>
                                    @if (!string.IsNullOrEmpty(nextDividendStatus))
                                    {
                                        <div class="small mt-1">
                                            Línea de esta fecha:
                                            <span class="dividend-status @(nextDividendStatus == DividendPaymentRules.StatusCollected ? "collected" : "pending")">@nextDividendStatus</span>
                                            · <a href="/dividends">Ver dividendos</a>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (Id.HasValue)
                            {
                                <div class="row">
                                    <div class="col-md-6 col-lg-3 mb-3">
                                        <label class="form-label fw-bold">Total Invertido Inicial</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">@currencySymbol</span>
                                            <input class="form-control" value="@company.TotalInvestedInitial.ToString("N2")" readonly />
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Calculado a partir de las operaciones abiertas
                                        </small>
                                    </div>
                                    <div class="col-md-6 col-lg-3 mb-3">
                                        <label class="form-label fw-bold">Número de Acciones</label>
                                        <input class="form-control form-control-lg" value="@ShareQuantity.Format(company.NumberOfShares)" readonly />
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Calculado a partir de las operaciones abiertas
                                        </small>
                                    </div>
                                    <div class="col-md-6 col-lg-3 mb-3">
                                        <label class="form-label fw-bold">Precio Medio de Compra</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">@currencySymbol</span>
                                            <input class="form-control" value="@(company.AveragePurchasePrice?.ToString("N2") ?? "–")" readonly />
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Total Invertido Inicial ÷ Número de Acciones
                                        </small>
                                    </div>
                                    <div class="col-md-6 col-lg-3 mb-3">
                                        <label class="form-label fw-bold">Total Valor Invertido</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">@currencySymbol</span>
                                            <input class="form-control" value="@company.TotalInvestedValue.ToString("N2")" readonly />
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Precio en Vivo (o Precio Actual si no hay) × Número de Acciones
                                        </small>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold">Total Dividendos</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">@currencySymbol</span>
                                            <input class="form-control" value="@company.TotalDividends.ToString("N2")" readonly />
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold">Rentabilidad Plusvalías</label>
                                        <div class="input-group input-group-lg">
                                            <input class="form-control" value="@company.PlusvaliaReturnPercent.ToString("N2")" readonly />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold">Rentabilidad con Dividendos</label>
                                        <div class="input-group input-group-lg">
                                            <input class="form-control" value="@company.DividendPlusvaliaReturnPercent.ToString("N2")" readonly />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Vista previa del enlace Investing -->
                            @if (!string.IsNullOrWhiteSpace(company.Ticker))
                            {
                                <div class="alert alert-info border-info">
                                    <h6 class="alert-heading">
                                        <i class="bi bi-link-45deg me-2"></i>
                                        Vista Previa del Enlace
                                    </h6>
                                    <p class="mb-2">
                                        <strong>URL Investing.com:</strong><br/>
                                        <code>https://www.investing.com/search/?q=@company.Ticker</code>
                                    </p>
                                    <a href="@($"https://www.investing.com/search/?q={company.Ticker}")" 
                                       target="_blank" 
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Probar enlace
                                    </a>
                                </div>
                            }

                            <!-- Mensaje de error -->
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>Error:</strong> @errorMessage
                                    <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
                                </div>
                            }

                            <!-- Botones de acción -->
                            <div class="d-flex gap-2 justify-content-end mt-4">
                                <button type="button" 
                                        class="btn btn-secondary btn-lg" 
                                        @onclick="Cancel"
                                        disabled="@isSaving">
                                    <i class="bi bi-x-circle me-2"></i>
                                    Cancelar
                                </button>
                                <button type="submit" 
                                        class="btn btn-primary btn-lg" 
                                        disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-2"></i>
                                        <span>Guardar Empresa</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// ID de la empresa a editar (null para nueva empresa)
    /// </summary>
    [Parameter]
    public int? Id { get; set; }

    /// <summary>
    /// Ticker del catálogo de mercado con el que abrir el alta ya rellena (/companies/new?from=SAN.MC)
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    // Modelo de la empresa
    private CompanyDetail company = new();

    // Estado de la línea de dividendo de la próxima fecha de la ficha (SPEC-21-01, RF-5)
    private string? nextDividendStatus;

    // Estados del componente
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    // Catálogo de países (SPEC-01-02) y divisa de la empresa según el país elegido
    private List<Country> countries = new();

    // Buscador del catálogo de mercado (SPEC-01-04)
    private string catalogText = string.Empty;
    private List<MarketCompany> catalogResults = new();
    private HashSet<string> ownedTickers = new();
    private string? catalogError;
    private string? catalogWarning;

    private string currentCurrency => CurrencyFormatter.Normalize(
        countries.FirstOrDefault(c => string.Equals(c.Code, company.CountryCode, StringComparison.OrdinalIgnoreCase))?.CurrencyCode);

    private string currencySymbol => CurrencyFormatter.Symbol(currentCurrency);

    // Propiedades calculadas para la UI
    private string pageTitle => Id.HasValue ? "Editar Empresa" : "Nueva Empresa";
    private string breadcrumbText => Id.HasValue ? "Editar" : "Nueva";
    private string iconClass => Id.HasValue ? "bi-pencil-square" : "bi-plus-circle";

    /// <summary>
    /// Se ejecuta al inicializar el componente
    /// Si hay ID, carga los datos de la empresa existente
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            countries = await CountryService.GetAllAsync();

            if (Id.HasValue)
            {
                // Modo edición: cargar empresa existente
                var existingCompany = await CompanyService.GetByIdAsync(Id.Value);
                if (existingCompany != null)
                {
                    company = existingCompany;
                    nextDividendStatus = await CompanyService.GetNextDividendStatusAsync(existingCompany.Id);
                }
                else
                {
                    errorMessage = "No se encontró la empresa especificada.";
                    await Task.Delay(2000);
                    Navigation.NavigateTo("/companies");
                }
            }
            else
            {
                // Modo creación: nueva empresa vacía
                company = new CompanyDetail();
                ownedTickers = await MarketCatalog.GetOwnedTickersAsync();

                // Alta desde el catálogo: /companies/new?from={ticker}
                if (!string.IsNullOrWhiteSpace(From))
                {
                    await PickFromCatalog(From);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Busca en el catálogo de mercado mientras el usuario escribe (máximo 10 resultados)
    /// </summary>
    private async Task SearchCatalog()
    {
        catalogError = null;
        catalogWarning = null;
        catalogResults = await MarketCatalog.SearchAsync(catalogText, 10);
    }

    /// <summary>
    /// Rellena nombre, ticker y país con la empresa elegida del catálogo, salvo que el ticker o el
    /// nombre ya estén en la lista del usuario (en ese caso muestra el motivo y no cambia la ficha)
    /// </summary>
    private async Task PickFromCatalog(string ticker)
    {
        catalogError = null;
        catalogWarning = null;

        var result = await MarketCatalog.PrepareCompanyAsync(ticker);
        if (result.Error != null)
        {
            catalogError = result.Error;
            return;
        }

        if (!result.Found)
        {
            return;
        }

        company.Name = result.Name;
        company.Ticker = result.Ticker;
        company.CountryCode = result.CountryCode;
        catalogWarning = result.Warning;
        catalogResults = new List<MarketCompany>();
        catalogText = string.Empty;
    }

    /// <summary>
    /// Maneja el envío del formulario cuando es válido
    /// </summary>
    private async Task HandleValidSubmit()
    {
        try
        {
            isSaving = true;
            errorMessage = string.Empty;

            // Convertir ticker a mayúsculas
            company.Ticker = company.Ticker?.ToUpper() ?? string.Empty;

            // Validar que el ticker no exista (excepto en edición)
            var tickerExists = await CompanyService.TickerExistsAsync(company.Ticker, Id);
            if (tickerExists)
            {
                errorMessage = $"Ya existe una empresa con el ticker '{company.Ticker}'. Por favor, use otro.";
                return;
            }

            // País obligatorio y cambio de país permitido (SPEC-01-02)
            var countryError = await CompanyService.GetCountryChangeErrorAsync(company);
            if (countryError != null)
            {
                errorMessage = countryError;
                return;
            }

            if (Id.HasValue)
            {
                // Actualizar empresa existente
                var success = await CompanyService.UpdateAsync(company);
                if (success)
                {
                    Navigation.NavigateTo("/companies");
                }
                else
                {
                    errorMessage = "No se pudo actualizar la empresa. Inténtelo de nuevo.";
                }
            }
            else
            {
                // Crear nueva empresa
                await CompanyService.AddAsync(company);
                Navigation.NavigateTo("/companies");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>
    /// Cancela la operación y vuelve a la lista
    /// </summary>
    private void Cancel()
    {
        Navigation.NavigateTo("/companies");
    }

}
