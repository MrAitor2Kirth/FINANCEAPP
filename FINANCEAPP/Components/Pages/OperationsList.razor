@page "/operations"
@using System.Globalization
@using FINANCEAPP.Models
@inject IOperationService OperationService
@inject ICompanyService CompanyService
@inject ICountryService CountryService
@inject IExchangeRateService ExchangeRateService
@inject IBankService BankService

<PageTitle>Operaciones Financieras</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="sw" style="--swatch:var(--indigo)">
                        <i class="bi bi-graph-up-arrow me-2"></i>
                        Operaciones Financieras
                    </h1>
                    <p class="lead text-muted">Gestión inline de operaciones de inversión</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/sales-history?from=operations" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-clock-history me-2"></i>
                        Histórico de ventas
                    </a>
                    <button class="btn btn-success btn-lg" @onclick="AddNewOperation">
                        <i class="bi bi-plus-circle me-2"></i>
                        Nueva Operación
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="ClearError"></button>
        </div>
    }

    @if (editingOperationId.HasValue && !string.IsNullOrEmpty(editWarning))
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-link-45deg me-2"></i>@editWarning
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando operaciones...</p>
        </div>
    }
    else if (operations == null || !operations.Any())
    {
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            <div>
                No hay operaciones registradas. Haga clic en "Nueva Operación" para comenzar.
            </div>
        </div>
    }
    else
    {
        <!-- Tarjetas de resumen -->
        <div class="stat-grid">
            <div class="stat-card" style="--swatch:var(--indigo)">
                <p class="stat-label">Total operaciones</p>
                <p class="stat-value">@filteredOperations.Count</p>
            </div>
            <div class="stat-card" style="--swatch:var(--teal)">
                <p class="stat-label">Operaciones abiertas</p>
                <p class="stat-value">@openOperationsCount</p>
            </div>
            <div class="stat-card" style="--swatch:var(--ink-soft)">
                <p class="stat-label">Operaciones cerradas</p>
                <p class="stat-value">@closedOperationsCount</p>
            </div>
            <div class="stat-card" style="--swatch:var(--amber)">
                <p class="stat-label">Total invertido</p>
                <p class="stat-value">@CurrencyFormatter.Format(totalAmount, baseCurrency.CurrencyCode)</p>
                @if (excludedOperationsCount > 0)
                {
                    <p class="stat-note small text-muted mb-0">@excludedOperationsCount @(excludedOperationsCount == 1 ? "operación en otra divisa no incluida" : "operaciones en otra divisa no incluidas") hasta que exista el tipo de cambio</p>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(selectedCompanyFilter))
        {
            <div class="alert alert-light border mb-3 d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-funnel-fill me-2 text-primary"></i>
                    <strong>Filtro activo:</strong> @selectedCompanyFilter
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearCompanyFilter">
                    <i class="bi bi-x-lg me-1"></i>Quitar filtro
                </button>
            </div>
        }

        <!-- Tabla de operaciones editable -->
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-table me-2"></i>Listado de Operaciones (Edición Inline)</h5>
                <small><i class="bi bi-info-circle me-1"></i>Haga clic en los campos para editarlos directamente</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 50px;" class="text-center">#</th>
                                <th scope="col" style="width: 190px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span>Empresa</span>
                                        <div class="dropdown">
                                            <button type="button"
                                                    class="btn btn-link btn-sm p-0 text-dark"
                                                    @onclick="ToggleCompanyFilterMenu"
                                                    title="Filtrar por empresa">
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                            @if (isCompanyFilterMenuOpen)
                                            {
                                                <div class="dropdown-menu show shadow-sm border" style="position: absolute; left: 0; top: 100%; min-width: 220px; z-index: 1050;">
                                                    <button type="button" class="dropdown-item @(string.IsNullOrWhiteSpace(selectedCompanyFilter) ? "active" : "")" @onclick="ClearCompanyFilter">
                                                        Todas las empresas
                                                    </button>
                                                    @foreach (var company in companies.OrderBy(c => c.Name))
                                                    {
                                                        <button type="button" class="dropdown-item @(selectedCompanyFilter == company.Name ? "active" : "")" @onclick="() => ApplyCompanyFilter(company.Name)">
                                                            @company.Name
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </th>
                                <th scope="col" style="width: 110px;">Tipo</th>
                                @if (showBankColumn)
                                {
                                    <th scope="col" style="width: 150px;">Cuenta bancaria</th>
                                }
                                <th scope="col" style="width: 125px;" class="text-center">Fecha Apertura</th>
                                <th scope="col" style="width: 125px;" class="text-center">Fecha Cierre</th>
                                <th scope="col" style="width: 105px;" class="text-end">Precio/Acción</th>
                                <th scope="col" style="width: 105px;" class="text-end">Precio en Vivo</th>
                                <th scope="col" style="width: 90px;" class="text-end">Nº Acciones</th>
                                <th scope="col" style="width: 90px;" class="text-end">Comisiones</th>
                                <th scope="col" style="width: 110px;" class="text-end">Importe Total</th>
                                <th scope="col" style="width: 90px;" class="text-center">Cód. divisa</th>
                                <th scope="col" style="width: 90px;" class="text-center">Estado</th>
                                <th scope="col" style="width: 120px;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var operation in filteredOperations)
                            {
                                @if (editingOperationId == operation.Id)
                                {
                                    <!-- Modo edición -->
                                    <tr class="table-warning">
                                        <td class="text-center align-middle">
                                            <span class="badge bg-warning text-dark">@operation.Id</span>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="editOperation.CompanyName" @bind:after="OnCompanySelected">
                                                <option value="">-- Seleccionar empresa --</option>
                                                @foreach (var company in companies)
                                                {
                                                    <option value="@company.Name">@company.Name</option>
                                                }
                                            </select>
                                            <a href="/companies/new" class="small d-block mt-1">¿No está? Añadir desde el catálogo</a>
                                            @if (isRefreshingSelectedCompanyLivePrice)
                                            {
                                                <small class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Actualizando precio en vivo...</small>
                                            }
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="editOperation.Type" @bind:after="OnTypeChanged" disabled="@(editLinkedAccountName != null)">
                                                <option value="Compra">Compra</option>
                                                <option value="Venta">Venta</option>
                                                <option value="Dividendo">Dividendo</option>
                                                <option value="Traspaso">Traspaso</option>
                                            </select>
                                        </td>
                                        <td>
                                            @* Cuenta donde se ingresa la liquidez de la venta (SPEC-02-04); vacía = la más antigua *@
                                            @if (operation.Id == 0 && editOperation.Type == "Venta")
                                            {
                                                @if (bankAccounts.Count == 0)
                                                {
                                                    <small class="text-danger d-block mt-1">Crea una cuenta bancaria en Banco antes de vender.</small>
                                                }
                                                else
                                                {
                                                    <select class="form-select form-select-sm" @bind="editBankAccountName" aria-label="Cuenta bancaria">
                                                        <option value="">Por defecto: @defaultBankAccountName</option>
                                                        @foreach (var account in bankAccounts)
                                                        {
                                                            <option value="@account.Name">@account.Name</option>
                                                        }
                                                    </select>
                                                }
                                            }
                                            @* Cuenta del movimiento de una Compra (Gasto) o Dividendo (Ingreso) (SPEC-02-06 y SPEC-02-07):
                                               alta = por defecto o «No registrar»; edición con movimiento = «Mantener» o cambiar de cuenta;
                                               edición sin movimiento = «Sin movimiento» o asignar cuenta (solo si no está cerrada) *@
                                            @if (OperationAmountCalculator.GeneratesBankMovement(editOperation.Type) && bankAccounts.Count > 0
                                                 && (operation.Id == 0 || editLinkedAccountName != null || !editOperationCloseDate.HasValue))
                                            {
                                                <select class="form-select form-select-sm" @bind="editBankAccountName" aria-label="Cuenta bancaria">
                                                    @if (operation.Id == 0)
                                                    {
                                                        <option value="">Por defecto: @defaultBankAccountName</option>
                                                        <option value="@OperationAmountCalculator.NoBankMovementValue">No registrar en banco</option>
                                                    }
                                                    else if (editLinkedAccountName != null)
                                                    {
                                                        <option value="">Mantener (@editLinkedAccountName)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">Sin movimiento</option>
                                                    }
                                                    @foreach (var account in bankAccounts)
                                                    {
                                                        <option value="@account.Name">@account.Name</option>
                                                    }
                                                </select>
                                            }
                                            else if (!(operation.Id == 0 && editOperation.Type == "Venta"))
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <InputDate class="form-control form-control-sm" 
                                                       @bind-Value="editOperationDate" />
                                        </td>
                                        <td>
                                            <InputDate class="form-control form-control-sm" 
                                                       @bind-Value="editOperationCloseDate" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm text-end"
                                                   @bind="editPricePerShare"
                                                   @bind:after="OnPricePerShareCommitted"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   placeholder="0.00" />
                                            @if (OperationAmountCalculator.IsAutoCalculated(editOperation.Type) && editPricePerShare <= 0 && editLivePrice > 0)
                                            {
                                                <small class="text-muted d-block">Se usará el precio en vivo @editLivePrice.ToString("N2")</small>
                                            }
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm text-end"
                                                   @bind="editLivePrice"
                                                   @bind:after="OnLivePriceCommitted"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   placeholder="0.00" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm text-end"
                                                   @bind="editNumberOfShares"
                                                   @bind:event="oninput"
                                                   @bind:after="RecalculateAmount"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   placeholder="0" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm text-end"
                                                   @bind="editCommission"
                                                   @bind:after="OnCommissionCommitted"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   placeholder="0.00" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm text-end fw-bold text-primary"
                                                   @bind="editCalculatedAmount"
                                                   @bind:after="OnAmountCommitted"
                                                   step="0.01"
                                                   min="0"
                                                   inputmode="decimal"
                                                   title="Puede introducir el importe manualmente"
                                                   placeholder="0.00" />
                                            @if (OperationAmountCalculator.IsAutoCalculated(editOperation.Type))
                                            {
                                                <small class="text-muted d-block">Se recalcula al cambiar precio, acciones o comisión</small>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-light text-dark border" title="La divisa es la de la empresa y no se puede editar">@CurrencyFormatter.Label(GetEditCurrency())</span>
                                            @if (!IsEditCurrencyBase())
                                            {
                                                <input type="number"
                                                       class="form-control form-control-sm text-end mt-1"
                                                       @bind="editExchangeRate"
                                                       step="0.000001"
                                                       min="0"
                                                       inputmode="decimal"
                                                       title="Tipo de cambio a @baseCurrency.CurrencyCode: se precarga con el actual y puedes cambiarlo o dejarlo vacío"
                                                       aria-label="Tipo de cambio"
                                                       placeholder="Tipo @(baseCurrency.CurrencyCode)" />
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            @* El estado es la fecha de cierre: Cerrada pone hoy (editable), Abierta la borra *@
                                            <select class="form-select form-select-sm"
                                                    value="@(editOperationCloseDate.HasValue ? "Cerrada" : "Abierta")"
                                                    @onchange="OnEditStatusChanged"
                                                    aria-label="Estado">
                                                <option value="Abierta">Abierta</option>
                                                <option value="Cerrada">Cerrada</option>
                                            </select>
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="btn-group-sm d-flex gap-1" role="group">
                                                <button type="button" 
                                                        class="btn btn-success btn-sm" 
                                                        @onclick="() => SaveOperation(operation.Id)"
                                                        disabled="@isSaving"
                                                        title="Guardar cambios">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-secondary btn-sm" 
                                                        @onclick="CancelEdit"
                                                        disabled="@isSaving"
                                                        title="Cancelar">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <!-- Modo visualización -->
                                    <tr>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-secondary">@operation.Id</span>
                                        </td>
                                        <td class="align-middle">
                                            <strong>@operation.CompanyName</strong>
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge @GetTypeBadgeClass(operation.Type)">
                                                @operation.Type
                                            </span>
                                        </td>
                                        @if (showBankColumn)
                                        {
                                            <td class="align-middle">
                                                @if (OperationAmountCalculator.GeneratesBankMovement(operation.Type) && tradeMovementAccounts.TryGetValue(OperationAmountCalculator.GetTradeMovementKey(operation), out var movementAccount))
                                                {
                                                    <span class="small"><i class="bi bi-bank me-1 text-muted"></i>@movementAccount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center align-middle">
                                            @operation.Date.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (operation.CloseDate.HasValue)
                                            {
                                                @operation.CloseDate.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end align-middle">@operation.PricePerShare.ToString("N4")</td>
                                        <td class="text-end align-middle">
                                            @{ var livePrice = GetLivePrice(operation.CompanyName); }
                                            @if (livePrice.HasValue)
                                            {
                                                <span class="text-info">@CurrencyFormatter.Format(livePrice.Value, operation.EffectiveCurrencyCode)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/D</span>
                                            }
                                        </td>
                                        <td class="text-end align-middle">@ShareQuantity.Format(operation.NumberOfShares)</td>
                                        <td class="text-end align-middle">@CurrencyFormatter.Format(operation.Commission, operation.EffectiveCurrencyCode)</td>
                                        <td class="text-end align-middle">
                                            <strong class="text-primary">@CurrencyFormatter.Format(operation.Amount, operation.EffectiveCurrencyCode)</strong>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-light text-dark border">@CurrencyFormatter.Label(operation.EffectiveCurrencyCode)</span>
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (operation.IsClosed)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Cerrada
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-arrow-clockwise me-1"></i>Abierta
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="btn-group-sm d-flex gap-1" role="group">
                                                <button type="button" 
                                                        class="btn btn-warning btn-sm" 
                                                        @onclick="() => TryStartEdit(operation)"
                                                        disabled="@(editingOperationId.HasValue)"
                                                        title="Editar">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-danger btn-sm" 
                                                        @onclick="() => TryConfirmDelete(operation)"
                                                        disabled="@(editingOperationId.HasValue)"
                                                        title="Eliminar">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-info btn-sm"
                                                        @onclick="() => ShowDetails(operation)"
                                                        title="Detalles">
                                                    <i class="bi bi-currency-exchange"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted">
                <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Mostrando @filteredOperations.Count operación(es) | 
                    @if (editingOperationId.HasValue)
                    {
                        <span class="text-warning"><strong>Editando operación...</strong></span>
                    }
                    else
                    {
                        <span>Haga clic en el icono de lápiz para editar</span>
                    }
                </small>
            </div>
        </div>
    }
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" 
     tabindex="-1" 
     style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
            </div>
            <div class="modal-body">
                @if (operationToDelete != null)
                {
                    <p class="mb-2">¿Está seguro que desea eliminar la siguiente operación?</p>
                    <div class="alert alert-warning">
                        <strong>Empresa:</strong> @operationToDelete.CompanyName<br/>
                        <strong>Tipo:</strong> @operationToDelete.Type<br/>
                        <strong>Importe:</strong> @CurrencyFormatter.Format(operationToDelete.Amount, operationToDelete.EffectiveCurrencyCode)<br/>
                        <strong>Fecha:</strong> @operationToDelete.Date.ToString("dd/MM/yyyy")
                    </div>
                    <p class="text-danger mb-0">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Esta acción no se puede deshacer.</strong>
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        @onclick="CancelDelete"
                        disabled="@isDeleting">
                    Cancelar
                </button>
                <button type="button" 
                        class="btn btn-danger" 
                        @onclick="DeleteOperation"
                        disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash-fill me-2"></i>
                        <span>Eliminar</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<ExchangeDetailsModal Details="exchangeDetails" OnClose="CloseDetails" />

@code {
    // Lista de operaciones
    private List<Operation>? operations;

    // Empresas disponibles
    private List<CompanyDetail> companies = new();

    // Filtro por empresa
    private string? selectedCompanyFilter;
    private bool isCompanyFilterMenuOpen;

    // Estados del componente
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool showDeleteModal = false;

    // Edición inline
    private int? editingOperationId = null;
    private Operation editOperation = new();
    private DateTime editOperationDate = DateTime.Now;
    private DateTime? editOperationCloseDate = null;

    // Campos desglosados del importe
    private decimal editPricePerShare = 0;
    private decimal editLivePrice = 0;
    // Acciones con hasta 2 decimales (SPEC-02-08)
    private decimal editNumberOfShares = 0;
    private decimal editCommission = 0;
    private decimal editCalculatedAmount = 0;
    private bool isRefreshingSelectedCompanyLivePrice = false;

    // Eliminación
    private Operation? operationToDelete = null;

    // Mensaje de error visible en pantalla
    private string? errorMessage;
    private string? editWarning;

    // Cuentas para ingresar la liquidez de una Venta nueva (SPEC-02-04)
    private List<BankAccount> bankAccounts = new();
    private string? defaultBankAccountName;
    private string editBankAccountName = string.Empty;

    // Movimientos bancarios de Compras y Dividendos (SPEC-02-06): clave de la operación → cuenta
    private Dictionary<int, string> tradeMovementAccounts = new();
    private string? editLinkedAccountName;

    // La columna «Cuenta bancaria» solo se ve mientras hay una fila en alta o edición (SPEC-02-07)
    private bool showBankColumn => editingOperationId.HasValue;

    // Métricas calculadas
    private List<Operation> filteredOperations =>
        string.IsNullOrWhiteSpace(selectedCompanyFilter)
            ? operations ?? new List<Operation>()
            : (operations ?? new List<Operation>()).Where(o => o.CompanyName == selectedCompanyFilter).ToList();

    private int openOperationsCount => filteredOperations.Count(o => !o.IsClosed);
    private int closedOperationsCount => filteredOperations.Count(o => o.IsClosed);
    // Total solo con operaciones de la divisa base (SPEC-01-02); el resto se cuenta aparte
    private BaseCurrencyInfo baseCurrency = new();
    private IEnumerable<Operation> baseCurrencyOperations => filteredOperations.Where(o =>
        string.Equals(o.EffectiveCurrencyCode, baseCurrency.CurrencyCode, StringComparison.OrdinalIgnoreCase));
    private decimal totalAmount => baseCurrencyOperations.Sum(o => o.Amount);
    private int excludedOperationsCount => filteredOperations.Count() - baseCurrencyOperations.Count();

    /// <summary>
    /// Precarga en la fila en edición el tipo de cambio actual de la divisa de la empresa (si hay y no es la base)
    /// </summary>
    private async Task PreloadExchangeRateAsync(string companyName)
    {
        var company = companies.FirstOrDefault(c => c.Name == companyName);
        if (company == null)
        {
            return;
        }

        var current = await ExchangeRateService.GetCurrentRateAsync(company.CurrencyCode);
        // Si el usuario cambió de empresa mientras tanto, no se pisa su fila
        if (current != null && editOperation.CompanyName == companyName && !editExchangeRate.HasValue)
        {
            editExchangeRate = current.Rate;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Divisa que mostrará la fila en edición: la de la empresa elegida (solo lectura)
    /// </summary>
    private string GetEditCurrency() =>
        companies.FirstOrDefault(c => c.Name == editOperation.CompanyName)?.CurrencyCode
        ?? CurrencyFormatter.DefaultCurrency;

    // Tipo de cambio de la fila en edición y ventana «Detalles» (SPEC-01-03)
    private decimal? editExchangeRate;
    private ExchangeDetails? exchangeDetails;

    private bool IsEditCurrencyBase() =>
        string.Equals(CurrencyFormatter.Normalize(GetEditCurrency()), baseCurrency.CurrencyCode, StringComparison.OrdinalIgnoreCase);

    private bool IsBaseOperation(Operation operation) =>
        string.Equals(operation.EffectiveCurrencyCode, baseCurrency.CurrencyCode, StringComparison.OrdinalIgnoreCase);

    private async Task ShowDetails(Operation operation)
    {
        exchangeDetails = await ExchangeRateService.GetOperationDetailsAsync(operation);
    }

    private void CloseDetails() => exchangeDetails = null;

    // Filtro de empresa desde la URL (SPEC-01-12: «Ver en operaciones» de /companies)
    [SupplyParameterFromQuery(Name = "company")]
    public string? CompanyQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadOperations();
        if (!string.IsNullOrWhiteSpace(CompanyQuery) && companies != null && companies.Any(c => c.Name == CompanyQuery))
        {
            ApplyCompanyFilter(CompanyQuery);
        }
    }

    private async Task LoadOperations()
    {
        try
        {
            isLoading = true;
            operations = await OperationService.GetAllAsync();
            companies = await CompanyService.GetAllAsync();
            baseCurrency = await CountryService.GetBaseCurrencyAsync();
            bankAccounts = await BankService.GetAllBankAccountsAsync();
            defaultBankAccountName = (await BankService.GetDefaultBankAccountAsync())?.Name;
            tradeMovementAccounts = await BankService.GetTradeMovementAccountsAsync(
                operations
                    .Where(o => OperationAmountCalculator.GeneratesBankMovement(o.Type))
                    .Select(OperationAmountCalculator.GetTradeMovementKey));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar operaciones: {ex.Message}");
            operations = new List<Operation>();
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Añade una nueva operación a la lista en modo edición
    /// </summary>
    private void AddNewOperation()
    {
        errorMessage = null;
        editBankAccountName = string.Empty;
        var newOperation = new Operation
        {
            Id = 0, // ID temporal para nueva operación
            CompanyName = "",
            Type = "Compra",
            Date = DateTime.Now,
            Amount = 0m,
            CreatedAt = DateTime.Now
        };

        operations?.Insert(0, newOperation);
        StartEdit(newOperation);
    }

    /// <summary>
    /// Edita una operación salvo que esté cerrada por una venta (en ese caso avisa de ir al histórico)
    /// </summary>
    private async Task TryStartEdit(Operation operation)
    {
        // Las operaciones ligadas a una venta del histórico se editan con aviso
        var warning = await OperationService.GetSaleEditWarningAsync(operation.Id);
        StartEdit(operation);
        editWarning = warning;
    }

    /// <summary>
    /// Pide confirmación para eliminar salvo que la operación esté cerrada por una venta
    /// </summary>
    private async Task TryConfirmDelete(Operation operation)
    {
        var lockMessage = await OperationService.GetSaleLockMessageAsync(operation.Id);
        if (lockMessage != null)
        {
            errorMessage = lockMessage;
            return;
        }

        ConfirmDelete(operation);
    }

    /// <summary>
    /// Cambia el estado en modo edición. El estado no se guarda aparte: es la fecha de cierre.
    /// Cerrada pone la fecha de hoy si no había ninguna (se puede cambiar en «Fecha Cierre»); Abierta la borra.
    /// </summary>
    private void OnEditStatusChanged(ChangeEventArgs e)
    {
        var status = e.Value?.ToString();
        if (status == "Cerrada")
        {
            editOperationCloseDate ??= DateTime.Today;

            // Una operación cerrada sin movimiento no admite cuenta (SPEC-02-07): se descarta la elegida
            if (editingOperationId != 0 && editLinkedAccountName == null)
            {
                editBankAccountName = string.Empty;
            }
        }
        else
        {
            editOperationCloseDate = null;
        }
    }

    /// <summary>
    /// Inicia el modo edición para una operación
    /// </summary>
    private void StartEdit(Operation operation)
    {
        // En una fila existente, vacío = mantener la cuenta del movimiento o seguir sin movimiento (SPEC-02-07)
        if (operation.Id != 0)
        {
            editBankAccountName = string.Empty;
        }

        editWarning = null;
        errorMessage = null;
        editingOperationId = operation.Id;
        editLinkedAccountName = operation.Id != 0
            && OperationAmountCalculator.GeneratesBankMovement(operation.Type)
            && tradeMovementAccounts.TryGetValue(OperationAmountCalculator.GetTradeMovementKey(operation), out var linkedAccount)
                ? linkedAccount
                : null;
        editOperation = new Operation
        {
            Id = operation.Id,
            CompanyName = operation.CompanyName,
            Type = operation.Type,
            Date = operation.Date,
            CloseDate = operation.CloseDate,
            Amount = operation.Amount,
            CreatedAt = operation.CreatedAt
        };

        // Tipo de cambio: se conserva el guardado; solo se precarga el actual si la operación no tiene (SPEC-01-03)
        editExchangeRate = operation.ExchangeRate;
        if (!editExchangeRate.HasValue && !string.IsNullOrWhiteSpace(operation.CompanyName))
        {
            _ = PreloadExchangeRateAsync(operation.CompanyName);
        }

        editOperationDate = operation.Date;
        editOperationCloseDate = operation.CloseDate;
        editPricePerShare = operation.PricePerShare;
        editNumberOfShares = operation.NumberOfShares;
        editCommission = operation.Commission;
        editCalculatedAmount = operation.Amount;
        // El precio en vivo arranca con el de la empresa de la fila (si está cargado); el importe guardado no se recalcula
        editLivePrice = Math.Round(companies.FirstOrDefault(c => c.Name == operation.CompanyName)?.LivePrice ?? 0m, 2);
    }

    /// <summary>
    /// Cancela el modo edición
    /// </summary>
    private void CancelEdit()
    {
        // Si es una nueva operación (Id = 0), eliminarla de la lista
        if (editingOperationId == 0)
        {
            operations?.RemoveAll(o => o.Id == 0);
        }

        editingOperationId = null;
        editLinkedAccountName = null;
        editOperation = new();
        editOperationDate = DateTime.Now;
        editOperationCloseDate = null;
        editPricePerShare = 0;
        editNumberOfShares = 0;
        editCommission = 0;
        editCalculatedAmount = 0;
        editLivePrice = 0;
    }

    /// <summary>
    /// Guarda los cambios de la operación
    /// </summary>
    private async Task SaveOperation(int operationId)
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            // Validaciones básicas
            if (string.IsNullOrWhiteSpace(editOperation.CompanyName))
            {
                errorMessage = "Debe seleccionar una empresa.";
                return;
            }

            // Validación y reglas del importe (SPEC-02-02)
            var validationError = OperationAmountCalculator.Validate(
                editOperation.Type, editPricePerShare, editLivePrice, editNumberOfShares, editCalculatedAmount);
            if (validationError != null)
            {
                errorMessage = validationError;
                return;
            }

            // En Compra y Venta se guarda el precio base (si solo había precio en vivo, se copia al precio por acción)
            var basePrice = OperationAmountCalculator.ResolveBasePrice(editPricePerShare, editLivePrice);
            editOperation.PricePerShare = OperationAmountCalculator.IsAutoCalculated(editOperation.Type) && basePrice.HasValue
                ? basePrice.Value
                : editPricePerShare;
            editOperation.NumberOfShares = editNumberOfShares;
            editOperation.Commission = editCommission;
            editOperation.Amount = Math.Round(editCalculatedAmount, 2);

            // Asignar fechas desde los campos de edición
            editOperation.Date = editOperationDate;
            editOperation.CloseDate = editOperationCloseDate;

            // Tipo de cambio: solo en empresas de otra divisa; el servicio lo valida y sella su destino
            editOperation.ExchangeRate = IsEditCurrencyBase() ? null : editExchangeRate;
            editOperation.ExchangeRateTo = null;

            if (operationId == 0)
            {
                if (editOperation.Type == "Venta")
                {
                    // La venta cierra compras por FIFO y se guarda en el histórico.
                    // Precio de venta: manda el precio por acción si está informado; si no, el precio en vivo.
                    var sellPrice = basePrice ?? editPricePerShare;
                    var result = await OperationService.RegisterSaleAsync(editOperation, sellPrice, editBankAccountName);
                    if (!result.Success)
                    {
                        errorMessage = result.ErrorMessage;
                        return; // se mantiene el modo edición para poder corregir
                    }
                }
                else
                {
                    await OperationService.AddAsync(editOperation, editBankAccountName);
                }

                // Recargar la lista completa
                await LoadOperations();
            }
            else
            {
                // Actualizar operación existente
                var success = await OperationService.UpdateAsync(editOperation, editBankAccountName);
                if (success)
                {
                    // Actualizar en la lista local
                    var index = operations?.FindIndex(o => o.Id == operationId);
                    if (index >= 0 && operations != null)
                    {
                        operations[index.Value] = editOperation;
                    }
                }
            }

            // Salir del modo edición
            editingOperationId = null;
            editOperation = new();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar operación: {ex.Message}");
            errorMessage = "No se pudo guardar la operación. No se ha modificado ningún dato.";
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>
    /// Muestra el modal de confirmación de eliminación
    /// </summary>
    private void ConfirmDelete(Operation operation)
    {
        operationToDelete = operation;
        showDeleteModal = true;
    }

    /// <summary>
    /// Cancela la eliminación
    /// </summary>
    private void CancelDelete()
    {
        operationToDelete = null;
        showDeleteModal = false;
    }

    /// <summary>
    /// Elimina la operación seleccionada
    /// </summary>
    private async Task DeleteOperation()
    {
        if (operationToDelete == null) return;

        try
        {
            isDeleting = true;
            var success = await OperationService.DeleteAsync(operationToDelete.Id);

            if (success)
            {
                await LoadOperations();
                showDeleteModal = false;
                operationToDelete = null;
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            showDeleteModal = false;
            operationToDelete = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar operación: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void ToggleCompanyFilterMenu()
    {
        isCompanyFilterMenuOpen = !isCompanyFilterMenuOpen;
    }

    private void ApplyCompanyFilter(string companyName)
    {
        selectedCompanyFilter = companyName;
        isCompanyFilterMenuOpen = false;
    }

    private void ClearCompanyFilter()
    {
        selectedCompanyFilter = null;
        isCompanyFilterMenuOpen = false;
    }

    /// <summary>
    /// Recalcula el importe con la regla de OperationAmountCalculator (solo Compra y Venta).
    /// Si no hay datos suficientes, el importe actual se mantiene.
    /// </summary>
    private void RecalculateAmount()
    {
        if (!OperationAmountCalculator.IsAutoCalculated(editOperation.Type))
        {
            return;
        }

        var amount = OperationAmountCalculator.Calculate(editPricePerShare, editLivePrice, editNumberOfShares, editCommission);
        if (amount.HasValue)
        {
            editCalculatedAmount = amount.Value;
        }
    }

    /// <summary>
    /// Al cambiar el tipo solo se recalcula si el importe está vacío o a 0.
    /// </summary>
    private void OnTypeChanged()
    {
        // «No registrar en banco» solo vale para Compra y Dividendo: al cambiar de tipo se vuelve a la cuenta por defecto
        editBankAccountName = string.Empty;

        if (editCalculatedAmount <= 0)
        {
            RecalculateAmount();
        }
    }

    // Los importes con decimales se enlazan al salir del campo (onchange): con oninput, Blazor borraba
    // la coma o el punto mientras se escribía y no dejaba teclear decimales. Se guardan con 2 decimales.
    private void OnLivePriceCommitted()
    {
        editLivePrice = Math.Round(editLivePrice, 2);
        RecalculateAmount();
    }

    private void OnAmountCommitted()
    {
        editCalculatedAmount = Math.Round(editCalculatedAmount, 2);
    }

    private void OnCommissionCommitted()
    {
        editCommission = Math.Round(editCommission, 2);
        RecalculateAmount();
    }

    private async Task OnPricePerShareCommitted()
    {
        editPricePerShare = Math.Round(editPricePerShare, 2);
        RecalculateAmount();

        // Actualizar precio actual de la empresa seleccionada
        if (editPricePerShare > 0 && !string.IsNullOrWhiteSpace(editOperation.CompanyName))
        {
            await CompanyService.UpdateCurrentPriceAsync(editOperation.CompanyName, editPricePerShare);
            // Reflejar en la lista local
            var company = companies.FirstOrDefault(c => c.Name == editOperation.CompanyName);
            if (company != null) company.CurrentPrice = editPricePerShare;
        }
    }

    /// <summary>
    /// Se dispara al seleccionar una empresa en el formulario de operación (alta o edición).
    /// Fuerza la recuperación del precio en vivo de dicha empresa.
    /// </summary>
    private async Task OnCompanySelected()
    {
        // No se arrastra el precio en vivo de la empresa anterior
        editLivePrice = 0;

        // El tipo de cambio de la empresa anterior tampoco: se precarga el actual de la nueva divisa
        editExchangeRate = null;

        var company = companies.FirstOrDefault(c => c.Name == editOperation.CompanyName);
        if (company == null)
        {
            return;
        }

        await PreloadExchangeRateAsync(company.Name);

        try
        {
            isRefreshingSelectedCompanyLivePrice = true;
            await InvokeAsync(StateHasChanged);

            await CompanyService.RefreshLivePriceAsync(company.Id);
            var refreshed = await CompanyService.GetByIdAsync(company.Id);
            if (refreshed != null)
            {
                company.LivePrice = refreshed.LivePrice;
                company.LivePriceUpdatedAt = refreshed.LivePriceUpdatedAt;
                company.LivePriceError = refreshed.LivePriceError;

                if (refreshed.LivePrice.HasValue)
                {
                    editLivePrice = Math.Round(refreshed.LivePrice.Value, 2);
                    RecalculateAmount();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar precio en vivo de la empresa seleccionada: {ex.Message}");
        }
        finally
        {
            isRefreshingSelectedCompanyLivePrice = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetTypeBadgeClass(string type)
    {
        return type?.ToLower() switch
        {
            "compra" => "bg-success",
            "venta" => "bg-danger",
            "dividendo" => "bg-info",
            "traspaso" => "bg-warning text-dark",
            _ => "bg-primary"
        };
    }

    /// <summary>
    /// Resuelve el precio en vivo de una empresa a partir de los datos ya cargados en memoria,
    /// sin necesidad de una nueva llamada a la API de Yahoo Finance.
    /// </summary>
    private decimal? GetLivePrice(string companyName)
    {
        return companies.FirstOrDefault(c => c.Name == companyName)?.LivePrice;
    }
