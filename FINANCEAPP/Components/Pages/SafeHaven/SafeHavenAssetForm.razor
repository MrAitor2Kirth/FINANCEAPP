@page "/activos-refugio/nuevo"
@page "/activos-refugio/editar/{id:int}"
@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject ISafeHavenService SafeHavenService
@inject NavigationManager Navigation
@inject ILogger<SafeHavenAssetForm> Logger

<PageTitle>@(Id == 0 ? "Nuevo Activo Refugio" : "Editar Activo")</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">@(Id == 0 ? "Crear Nuevo Activo Refugio" : "Editar Activo Refugio")</h5>
                </div>

                <div class="card-body">
                    @if (asset == null)
                    {
                        <div class="alert alert-info">Cargando...</div>
                    }
                    else
                    {
                        <EditForm Model="@asset" OnValidSubmit="@HandleSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                            <DataAnnotationsValidator />

                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Nombre del Activo *</label>
                                    <InputText class="form-control" placeholder="Ej: Oro en Lingotes"
                                              @bind-Value="asset.Name" />
                                    <ValidationMessage For="@(() => asset.Name)" class="text-danger" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Tipo de Activo Refugio *</label>
                                    <InputSelect class="form-select" @bind-Value="asset.AssetType">
                                        <option value="">Seleccionar tipo...</option>
                                        <option value="Oro">Oro</option>
                                        <option value="Plata">Plata</option>
                                        <option value="Platino">Platino</option>
                                        <option value="Paladio">Paladio</option>
                                        <option value="Bitcoin">Bitcoin</option>
                                        <option value="Ethereum">Ethereum</option>
                                        <option value="Criptomonedas Otras">Otras Criptomonedas</option>
                                        <option value="Bonos del Tesoro">Bonos del Tesoro</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => asset.AssetType)" class="text-danger" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Total Invertido (€) *</label>
                                    <InputNumber class="form-control" placeholder="Ej: 5000.00"
                                               @bind-Value="asset.TotalInvested" step="0.01" />
                                    <ValidationMessage For="@(() => asset.TotalInvested)" class="text-danger" />
                                    <small class="text-muted">Se actualizará automáticamente al registrar operaciones</small>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Valor Actual (€) *</label>
                                    <InputNumber class="form-control" placeholder="Ej: 5000.00"
                                                 @bind-Value="asset.CurrentValue" step="0.01" />
                                    <ValidationMessage For="@(() => asset.CurrentValue)" class="text-danger" />
                                    <small class="text-muted">Se actualizará automáticamente al registrar operaciones</small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @errorMessage
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-warning" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @(Id == 0 ? "Crear Activo" : "Guardar Cambios")
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="NavigateBack">
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Tipos de Activos Refugio</h6>
                </div>
                <div class="card-body small">
                    <h6>Metales Preciosos:</h6>
                    <ul class="mb-2">
                        <li>Oro 🥇</li>
                        <li>Plata 🥈</li>
                        <li>Platino</li>
                    </ul>
                    <h6>Criptomonedas:</h6>
                    <ul class="mb-2">
                        <li>Bitcoin ₿</li>
                        <li>Ethereum Ξ</li>
                    </ul>
                    <h6>Otros:</h6>
                    <ul>
                        <li>Bonos del Tesoro</li>
                        <li>USD/Efectivo</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private SafeHavenAsset asset = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Id > 0)
            {
                var existingAsset = await SafeHavenService.GetAssetByIdAsync(Id);
                if (existingAsset != null)
                {
                    asset = existingAsset;
                }
                else
                {
                    errorMessage = "Activo no encontrado";
                }
            }
            else
            {
                asset = new SafeHavenAsset
                {
                    CreatedAt = DateTime.Now,
                    UpdatedAt = DateTime.Now
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando activo");
            errorMessage = "Error al cargar el activo";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            asset.UpdatedAt = DateTime.Now;

            if (Id == 0)
            {
                asset.CreatedAt = DateTime.Now;
                await SafeHavenService.CreateAssetAsync(asset);
            }
            else
            {
                asset.Id = Id;
                await SafeHavenService.UpdateAssetAsync(asset);
            }

            Navigation.NavigateTo("/activos-refugio");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error guardando activo");
            errorMessage = $"Error al guardar el activo: {ex.Message}";
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Por favor completa todos los campos requeridos correctamente";
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/activos-refugio");
    }
}
