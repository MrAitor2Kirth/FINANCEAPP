@page "/activos-refugio"
@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject ISafeHavenService SafeHavenService
@inject NavigationManager Navigation
@inject ILogger<SafeHavenAssetsList> Logger

<PageTitle>Activos Refugio</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-12">
            <h1 class="sw" style="--swatch:var(--amber)">Gestión de Activos Refugio</h1>
            <p class="text-muted">Administra inversiones en oro, plata, bitcoin y otros activos refugio</p>
        </div>
    </div>

    @* Cinta de acciones *@
    <div class="row mb-3">
        <div class="col-12">
            <div class="btn-toolbar gap-2" role="toolbar">
                <button class="btn btn-primary" @onclick="NavigateToNew">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo
                </button>
                <button class="btn btn-secondary" @onclick="EditSelected" disabled="@(selectedAsset == null)">
                    <i class="bi bi-pencil me-1" aria-hidden="true"></i> Editar
                </button>
                <button class="btn btn-danger" @onclick="DeleteSelected" disabled="@(selectedAsset == null)">
                    <i class="bi bi-trash me-1" aria-hidden="true"></i> Eliminar
                </button>
                <button class="btn btn-outline-primary" @onclick="ToggleOperations" disabled="@(selectedAsset == null)">
                    <i class="bi bi-list-ul me-1" aria-hidden="true"></i> Ver Operaciones
                </button>
            </div>
            @if (selectedAsset != null)
            {
                <small class="text-muted mt-1 d-block">
                    Seleccionado: <strong>@selectedAsset.Name</strong>
                </small>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span> Cargando activos...
        </div>
    }
    else if (assets == null || assets.Count == 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> No hay activos refugio registrados. Usa el botón <strong>Nuevo</strong> para crear el primero.
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0">Desglose por Tipo de Activo</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var breakdown in assetBreakdown)
                            {
                                <div class="col-md-3 mb-3">
                                    <div class="card border-warning">
                                        <div class="card-body text-center">
                                            <h6 class="card-title">@breakdown.Key</h6>
                                            <h5 class="text-warning">@breakdown.Value.ToString("C")</h5>
                                            <small class="text-muted">
                                                @(assets.Count(a => a.AssetType == breakdown.Key)) activos
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo de Activo</th>
                        <th>Total Invertido</th>
                        <th>Valor Actual</th>
                        <th>% del Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asset in assets.OrderByDescending(a => a.TotalInvested))
                    {
                        decimal percentage = totalInvested > 0 ? (asset.TotalInvested / totalInvested) * 100 : 0;
                        bool isSelected = selectedAsset?.Id == asset.Id;

                        <tr class="@(isSelected ? "table-primary" : "")" style="cursor:pointer"
                            @onclick="() => SelectAsset(asset)">
                            <td>
                                <strong>@asset.Name</strong>
                            </td>
                            <td>
                                <span class="badge @GetAssetTypeBadgeClass(asset.AssetType)">
                                    @asset.AssetType
                                </span>
                            </td>
                            <td class="text-end">@asset.TotalInvested.ToString("C")</td>
                            <td class="text-end">@asset.CurrentValue.ToString("C")</td>
                            <td>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar" role="progressbar"
                                         style="width: @(percentage)%">
                                        @(percentage.ToString("F1"))%
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @if (isSelected && showOperations)
                        {
                            <tr class="table-secondary">
                                <td colspan="4">
                                    <div class="p-3">
                                        <h6 class="mb-3">Operaciones de <strong>@asset.Name</strong></h6>
                                        <SafeHavenOperationsList AssetName="@asset.Name" SafeHavenService="@SafeHavenService" OnOperationAdded="@RefreshAssets" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SafeHavenAsset> assets = new();
    private bool isLoading = true;
    private SafeHavenAsset? selectedAsset = null;
    private bool showOperations = false;
    private decimal totalInvested = 0;
    private decimal totalCurrentValue = 0;
    private Dictionary<string, decimal> assetBreakdown = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAssets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar activos");
        }
    }

    private async Task RefreshAssets()
    {
        isLoading = true;
        try
        {
            assets = await SafeHavenService.GetAllAssetsAsync();
            totalInvested = assets.Sum(a => a.TotalInvested);
            totalCurrentValue = assets.Sum(a => a.CurrentValue);

            // Calcular desglose por tipo
            assetBreakdown = new Dictionary<string, decimal>();
            foreach (var asset in assets)
            {
                if (assetBreakdown.ContainsKey(asset.AssetType))
                {
                    assetBreakdown[asset.AssetType] += asset.TotalInvested;
                    assetBreakdown[asset.AssetType] += asset.CurrentValue;
                }
                else
                {
                    assetBreakdown[asset.AssetType] = asset.TotalInvested;
                    assetBreakdown[asset.AssetType] = asset.CurrentValue;
                }
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al refrescar activos");
            isLoading = false;
        }
    }

    private void SelectAsset(SafeHavenAsset asset)
    {
        if (selectedAsset?.Id == asset.Id)
        {
            selectedAsset = null;
            showOperations = false;
        }
        else
        {
            selectedAsset = asset;
            showOperations = false;
        }
    }

    private void ToggleOperations()
    {
        if (selectedAsset != null)
            showOperations = !showOperations;
    }

    private void EditSelected()
    {
        if (selectedAsset != null)
            Navigation.NavigateTo($"/activos-refugio/editar/{selectedAsset.Id}");
    }

    private async Task DeleteSelected()
    {
        if (selectedAsset == null) return;
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas eliminar '{selectedAsset.Name}'?"))
        {
            try
            {
                await SafeHavenService.DeleteAssetAsync(selectedAsset.Id);
                selectedAsset = null;
                showOperations = false;
                await RefreshAssets();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error al eliminar activo");
            }
        }
    }

    private void NavigateToNew()
    {
        Navigation.NavigateTo("/activos-refugio/nuevo");
    }

    private string GetAssetTypeBadgeClass(string assetType)
    {
        return assetType switch
        {
            "Oro" => "bg-warning",
            "Plata" => "bg-secondary",
            "Bitcoin" => "bg-danger",
            "Ethereum" => "bg-info",
            _ => "bg-dark"
        };
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}
