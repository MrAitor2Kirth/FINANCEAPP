@page "/companies"
@inject ICompanyService CompanyService
@inject ICountryService CountryService
@inject IExchangeRateService ExchangeRateService
@inject IPortfolioPeriodService PortfolioPeriodService
@using System.Globalization
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Empresas</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="sw" style="--swatch:var(--indigo)">
                        <i class="bi bi-building me-2"></i>
                        Catálogo de Empresas
                    </h1>
                    <p class="lead text-muted">Información detallada de empresas y oportunidades de inversión</p>
                </div>
                <div class="d-flex gap-2">
                    @* Calendario de dividendos (SPEC-21-01, RF-2) *@
                    <a href="/dividends" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-calendar-check me-2"></i>
                        Dividendos
                    </a>
                    @* Índices para comparar en el gráfico (SPEC-05-04, RF-1) *@
                    <a href="/indices" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-bar-chart-line me-2"></i>
                        Índices
                    </a>
                    <button class="btn btn-outline-info btn-lg" @onclick="RefreshLivePricesInBackground" disabled="@isRefreshingLivePrices">
                        @if (isRefreshingLivePrices)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Actualizando...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            <span>Actualizar Precios en Vivo</span>
                        }
                    </button>
                    <button class="btn btn-primary btn-lg" @onclick="CreateNewCompany">
                        <i class="bi bi-plus-circle me-2"></i>
                        Nueva Empresa
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <!-- Indicador de carga -->
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando empresas...</p>
        </div>
    }
    else if (companies == null || !companies.Any())
    {
        <!-- Mensaje cuando no hay datos -->
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            <div>
                No hay empresas registradas en el sistema.
            </div>
        </div>
    }
    else
    {
        @* Filtro por periodo de las tarjetas (SPEC-01-09): mismo selector que /sales-history; la lista no cambia *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <div class="btn-group" role="group" aria-label="Modo de periodo">
                @foreach (var option in periodModes)
                {
                    var mode = option.Mode;
                    <button type="button" class="btn btn-sm @(periodFilter.Mode == mode ? "btn-primary" : "btn-outline-primary")" disabled="@isLoadingPeriod" @onclick="() => SetPeriodMode(mode)">@option.Text</button>
                }
            </div>
            @if (periodFilter.Mode != SalesPeriodMode.All)
            {
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isLoadingPeriod" @onclick="PreviousPeriod" title="Periodo anterior" aria-label="Periodo anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    @if (periodFilter.Mode == SalesPeriodMode.Day)
                    {
                        <input type="date" class="form-control form-control-sm" style="width:auto"
                               value="@periodFilter.Reference.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               @onchange="OnPeriodDayChanged" />
                    }
                    else if (periodFilter.Mode == SalesPeriodMode.Month)
                    {
                        <input type="month" class="form-control form-control-sm" style="width:auto"
                               value="@periodFilter.Reference.ToString("yyyy-MM", CultureInfo.InvariantCulture)"
                               @onchange="OnPeriodMonthChanged" />
                    }
                    else
                    {
                        <input type="number" class="form-control form-control-sm" style="width:6rem"
                               min="@SalesPeriodFilter.MinYear" max="@SalesPeriodFilter.MaxYear" step="1"
                               value="@periodFilter.Reference.Year"
                               @onchange="OnPeriodYearChanged" />
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isLoadingPeriod" @onclick="NextPeriod" title="Periodo siguiente" aria-label="Periodo siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                @* Lectura del periodo (RF-2) *@
                <div class="btn-group ms-md-2" role="group" aria-label="Vista del periodo">
                    @foreach (var option in periodViews)
                    {
                        var view = option.View;
                        <button type="button" class="btn btn-sm @(periodView == view ? "btn-secondary" : "btn-outline-secondary")" disabled="@isLoadingPeriod" @onclick="() => SetPeriodView(view)">@option.Text</button>
                    }
                </div>
            }
            <span class="fw-bold ms-1">@periodFilter.Label</span>
            @if (isLoadingPeriod)
            {
                <span class="spinner-border spinner-border-sm text-secondary ms-1" role="status"></span>
            }
        </div>
        @if (periodFilter.Mode != SalesPeriodMode.All)
        {
            <p class="small text-muted mb-2"><i class="bi bi-info-circle me-1"></i>@PeriodExplanation</p>
        }
        @if (!string.IsNullOrEmpty(periodError))
        {
            <div class="alert alert-warning py-1 px-2 small">@periodError</div>
        }
        @foreach (var warning in periodSummary?.Warnings ?? new List<string>())
        {
            <div class="alert alert-warning py-1 px-2 small mb-2"><i class="bi bi-exclamation-triangle me-1"></i>@warning</div>
        }

        <!-- Tarjetas de resumen (SPEC-01-08): bloque «Cartera» y bloque «Rentabilidad y diversificación».
             Todo con las empresas con inversión y sus totales convertidos a la divisa base (SPEC-01-05) -->
        <p class="stat-section">Cartera</p>
        <div class="stat-grid stat-grid-3">
            <div class="stat-card" style="--swatch:var(--plum)">
                <p class="stat-label">Invertido (coste)</p>
                <p class="stat-value">@(CardResult.HasValue ? CurrencyFormatter.Format(CardTotals.InvestedInitial, CardTotals.BaseCurrencyCode) : "—")</p>
            </div>
            <div class="stat-card" style="--swatch:var(--indigo)">
                <p class="stat-label">@ValueLabel</p>
                <p class="stat-value">@(CardResult.HasValue ? CurrencyFormatter.Format(CardTotals.CurrentValue, CardTotals.BaseCurrencyCode) : "—")</p>
            </div>
            <div class="stat-card" style="--swatch:@(SignSwatch(CardResult))">
                <p class="stat-label">Resultado</p>
                @if (CardResult.HasValue)
                {
                    <p class="stat-value" style="color:@SignSwatch(CardResult)">
                        @(CardResult.Value >= 0 ? "▲ +" : "▼ ")@CurrencyFormatter.Format(CardResult.Value, CardTotals.BaseCurrencyCode)
                    </p>
                    @if (CardDividends > 0)
                    {
                        <p class="stat-sub">+ @CurrencyFormatter.Format(CardDividends, CardTotals.BaseCurrencyCode) @CardDividendsText</p>
                    }
                }
                else
                {
                    <p class="stat-value">—</p>
                }
            </div>
        </div>
        @if (CardTotals.MissingRateCompanies > 0)
        {
            @* Un solo aviso para los dos bloques: todos usan los mismos totales (SPEC-01-08, D5) *@
            <p class="stat-note small text-muted">
                <i class="bi bi-info-circle me-1"></i>@CardTotals.MissingRateCompanies @(CardTotals.MissingRateCompanies == 1 ? "empresa en otra divisa sin tipo de cambio no incluida" : "empresas en otra divisa sin tipo de cambio no incluidas") en los importes ni en la rentabilidad. <a href="/settings">Configurar tipos</a>
            </p>
        }

        @if (periodSummary != null && !periodSummary.HasData)
        {
            <p class="stat-note small text-muted"><i class="bi bi-info-circle me-1"></i>@(periodSummary.IsFuture ? "Sin datos para un periodo futuro." : periodView == PeriodSummaryView.Purchases ? "Sin compras en este periodo que sigas teniendo." : "No tenías acciones en esa fecha.")</p>
        }
        @if (periodSummary != null && periodSummary.SoldPurchasesAmount > 0)
        {
            <p class="stat-note small text-muted">
                <i class="bi bi-info-circle me-1"></i>@CurrencyFormatter.Format(periodSummary.SoldPurchasesAmount, CardTotals.BaseCurrencyCode) de compras de este periodo ya vendidas. <a href="/sales-history">Ver histórico de ventas</a>
            </p>
        }

        <p class="stat-section">Rentabilidad y diversificación</p>
        <div class="stat-grid stat-grid-4">
            @* Por precio (SPEC-01-05) y con dividendos (SPEC-01-07), ponderadas por lo invertido *@
            <div class="stat-card span-2" style="--swatch:@(SignSwatch(CardReturn))">
                <p class="stat-label">Rentabilidad media</p>
                @if (CardReturn.HasValue)
                {
                    <p class="stat-value" style="color:@SignSwatch(CardReturn)">
                        @(CardReturn.Value >= 0 ? "▲" : "▼") @CardReturn.Value.ToString("N2")%
                        <span class="stat-value-unit">por precio</span>
                    </p>
                }
                else
                {
                    <p class="stat-value">—</p>
                }
                @if (CardReturnWithDividends.HasValue && (periodSummary == null || periodSummary.ShowReturnWithDividends))
                {
                    <p class="stat-sub">
                        <span style="color:@SignSwatch(CardReturnWithDividends)">@(CardReturnWithDividends.Value >= 0 ? "▲" : "▼") @CardReturnWithDividends.Value.ToString("N2")%</span>
                        con dividendos
                    </p>
                }
            </div>
            <div class="stat-card" style="--swatch:var(--teal)">
                <p class="stat-label">Empresas · sectores</p>
                <p class="stat-value">@CardCompanies.Count · @CardSectorsCount</p>
                @if (periodSummary == null && CardCompanies.Count < companies.Count)
                {
                    <p class="stat-sub">de @companies.Count en el catálogo</p>
                }
            </div>
            <div class="stat-card" style="--swatch:var(--amber)">
                <p class="stat-label">Yield medio</p>
                <p class="stat-value">@(CardDividendYield.HasValue ? CardDividendYield.Value.ToString("N2") + "%" : "—")</p>
            </div>
        </div>

        <!-- Tabla de empresas -->
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-table me-2"></i>Listado de Empresas</h5>
                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        @onclick="ToggleExtended"
                        aria-pressed="@(isExtended ? "true" : "false")">
                    <i class="bi @(isExtended ? "bi-arrows-collapse" : "bi-arrows-expand") me-1" aria-hidden="true"></i>
                    @(isExtended ? "Lista extendida" : "Lista extendible")
                </button>
            </div>
            <div class="card-body p-0">
                @* Modo corto: solo empresas con inversión (SPEC-01-05); la lista extendida muestra todo el catálogo *@
                @if (!isExtended && periodSummary != null)
                {
                    @* SPEC-01-10: con un periodo, la tabla muestra las empresas y las cifras del periodo *@
                    <div class="small text-muted px-3 pt-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Mostrando @periodSummary.Companies.Count de @companies.Count empresas @PeriodListText. Pulsa «Lista extendible» para ver todas.
                    </div>
                }
                else if (!isExtended && investedCompanies.Count == 0)
                {
                    <div class="alert alert-info m-3 mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        No hay empresas con inversión. Pulsa «Lista extendible» para ver todo el catálogo.
                    </div>
                }
                else if (!isExtended && investedCompanies.Count < companies.Count)
                {
                    <div class="small text-muted px-3 pt-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Mostrando @investedCompanies.Count de @companies.Count empresas (solo las que tienen inversión). Pulsa «Lista extendible» para ver todas.
                    </div>
                }
                <div class="table-responsive" hidden="@(visibleCompanies.Count == 0)">
                    <table class="table table-sm table-hover align-middle mb-0 companies-table @(isExtended ? "" : "companies-table--compact")">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Empresa</th>
                                <th scope="col" class="text-end">Precio</th>
                                <th scope="col" class="text-end">Inversión</th>
                                <th scope="col" class="text-end">@(isExtended ? "Dividendos" : "Nº acciones")</th>
                                <th scope="col">Rentabilidad</th>
                                <th scope="col" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in visibleCompanies)
                            {
                                <tr>
                                    <td>
                                        @if (isExtended)
                                        {
                                            <strong>@company.Name</strong>
                                            <div class="mt-1 d-flex flex-wrap gap-1">
                                                <span class="badge bg-primary">@company.Ticker</span>
                                                <span class="badge @GetSectorBadgeClass(company.Sector)">@company.Sector</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <strong>@company.Name</strong>
                                                <span class="badge bg-primary">@company.Ticker</span>
                                                <span class="badge @GetSectorBadgeClass(company.Sector)">@company.Sector</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (isExtended)
                                        {
                                            <div class="cell-pair">
                                                <span class="cell-label">Medio compra</span>
                                                <strong>@(company.AveragePurchasePrice.HasValue ? CurrencyFormatter.Format(company.AveragePurchasePrice.Value, company.CurrencyCode) : "–")</strong>
                                            </div>
                                            <div class="cell-pair">
                                                <span class="cell-label">En vivo</span>
                                                @if (company.LivePrice.HasValue)
                                                {
                                                    <strong class="text-info">@CurrencyFormatter.Format(company.LivePrice.Value, company.CurrencyCode)</strong>
                                                }
                                                else if (isRefreshingLivePrices)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-muted" role="status"></span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/D</span>
                                                }
                                            </div>
                                            @if (company.LivePrice.HasValue && company.LivePriceUpdatedAt.HasValue)
                                            {
                                                <small class="text-muted">@GetRelativeTime(company.LivePriceUpdatedAt.Value)</small>
                                            }
                                        }
                                        else
                                        {
                                            <div title="@(company.LivePrice.HasValue && company.LivePriceUpdatedAt.HasValue ? GetRelativeTime(company.LivePriceUpdatedAt.Value) : null)">
                                                @if (company.LivePrice.HasValue)
                                                {
                                                    <strong class="text-info">@CurrencyFormatter.Format(company.LivePrice.Value, company.CurrencyCode)</strong>
                                                }
                                                else if (isRefreshingLivePrices)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-muted" role="status"></span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/D</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (isExtended)
                                        {
                                            <div class="cell-pair">
                                                <span class="cell-label">Inicial</span>
                                                <span>@CurrencyFormatter.Format(company.TotalInvestedInitial, company.CurrencyCode)</span>
                                            </div>
                                            <div class="cell-pair">
                                                <span class="cell-label">Valor</span>
                                                <strong>@CurrencyFormatter.Format(company.TotalInvestedValue, company.CurrencyCode)</strong>
                                            </div>
                                            <div class="cell-pair">
                                                <span class="cell-label">Nº acciones</span>
                                                <span>@ShareQuantity.Format(company.NumberOfShares)</span>
                                            </div>
                                            @* Peso de lo invertido en esta empresa sobre el total invertido (SPEC-01-06) *@
                                            <div class="cell-pair">
                                                <span class="cell-label">Peso</span>
                                                @if (weights.TryGetValue(company.Id, out var weight))
                                                {
                                                    <span>@weight.ToString("N2")%</span>
                                                }
                                                else if (InvestedCompaniesSummary.HasInvestment(company))
                                                {
                                                    <span class="text-muted" title="Sin tipo de cambio: no se incluye en el peso">—</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <strong>@CurrencyFormatter.Format(company.TotalInvestedValue, company.CurrencyCode)</strong>
                                        }
                                    </td>
                                    @if (isExtended)
                                    {
                                        <td class="text-end">
                                            <strong class="text-success">@CurrencyFormatter.Format(company.TotalDividends, company.CurrencyCode)</strong>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-end">@ShareQuantity.Format(company.NumberOfShares)</td>
                                    }
                                    <td>
                                        @if (isExtended)
                                        {
                                            <div class="cell-pair">
                                                <span class="cell-label">Precio</span>
                                                <span class="badge @GetPerformanceBadgeClass(company.PlusvaliaReturnPercent)">@company.PlusvaliaReturnPercent.ToString("N2")%</span>
                                            </div>
                                            <div class="cell-pair mt-1">
                                                <span class="cell-label">Con div.</span>
                                                <span class="badge @GetPerformanceBadgeClass(company.DividendPlusvaliaReturnPercent)">@company.DividendPlusvaliaReturnPercent.ToString("N2")%</span>
                                            </div>
                                            <div class="cell-pair mt-1">
                                                <span class="cell-label">Yield</span>
                                                @if (company.DividendYield > 0)
                                                {
                                                    <span class="badge @GetDividendYieldBadgeClass(company.DividendYield)">@company.FormattedDividendYield</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge @GetPerformanceBadgeClass(company.PlusvaliaReturnPercent)">@company.PlusvaliaReturnPercent.ToString("N2")%</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@company.InvestingUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver información en Investing.com"
                                               aria-label="Ver información en Investing.com">
                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-warning"
                                                    @onclick="() => EditCompany(company.Id)"
                                                    title="Editar empresa"
                                                    aria-label="Editar empresa">
                                                <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ConfirmDelete(company)"
                                                    title="Eliminar empresa"
                                                    aria-label="Eliminar empresa">
                                                <i class="bi bi-trash-fill" aria-hidden="true"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info"
                                                    @onclick="() => ShowDetails(company)"
                                                    title="Detalles"
                                                    aria-label="Detalles">
                                                <i class="bi bi-currency-exchange" aria-hidden="true"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => ShowChart(company)"
                                                    title="Ver gráfico de cotización"
                                                    aria-label="Ver gráfico de cotización">
                                                <i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer text-muted">
                <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Mostrando @visibleCompanies.Count empresa(s) de las @companies.Count registrada(s) en el sistema
                </small>
            </div>
        </div>

        <!-- Sección de Enlaces Externos -->
        <div class="alert alert-light border mt-4" role="alert">
            <h5 class="alert-heading">
                <i class="bi bi-link-45deg me-2"></i>
                Acerca de los Enlaces
            </h5>
            <p class="mb-0">
                Los botones con el icono de enlace externo se abren en una nueva pestaña y dirigen al sitio 
                <strong>Investing.com</strong> para consultar información actualizada sobre cada empresa.
                Los datos se buscan automáticamente usando el ticker de cotización.
            </p>
        </div>
    }
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" 
     tabindex="-1" 
     style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
            </div>
            <div class="modal-body">
                @if (companyToDelete != null)
                {
                    <p class="mb-2">¿Está seguro que desea eliminar la siguiente empresa?</p>
                    <div class="alert alert-warning">
                        <strong>Nombre:</strong> @companyToDelete.Name<br/>
                        <strong>Ticker:</strong> @companyToDelete.Ticker<br/>
                        <strong>Sector:</strong> @companyToDelete.Sector
                    </div>
                    @if (companyToDeleteOperationsCount > 0)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>
                            Se eliminarán también sus <strong>@companyToDeleteOperationsCount operación(es)</strong>
                            y el histórico de cotización guardado.
                            @if (companyToDeleteBankMovementsCount > 0)
                            {
                                <span>Desaparecerán también <strong>@companyToDeleteBankMovementsCount movimiento(s) bancario(s)</strong> generados por sus compras y dividendos, y los saldos de las cuentas se recalcularán.</span>
                            }
                        </div>
                    }
                    @if (companyToDeleteDividendsCount > 0)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-calendar-x me-1"></i>
                            Se eliminarán también sus <strong>@companyToDeleteDividendsCount línea(s) del calendario de dividendos</strong>.
                        </div>
                    }
                    <p class="text-danger mb-0">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        <strong>Esta acción no se puede deshacer.</strong>
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        @onclick="CancelDelete"
                        disabled="@isDeleting">
                    Cancelar
                </button>
                <button type="button" 
                        class="btn btn-danger" 
                        @onclick="DeleteCompany"
                        disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Eliminando...</span>
                    }
                    else
                    {
                        <i class="bi bi-trash-fill me-2"></i>
                        <span>Eliminar</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<CompanyChartModal @ref="chartModal" OnClosed="OnChartClosed" />

<ExchangeDetailsModal Details="exchangeDetails" OnClose="CloseDetails" />

@code {
    // Lista de empresas obtenidas del servicio
    private List<CompanyDetail>? companies;

    // Indicador de estado de carga
    private bool isLoading = true;

    // Estado del modal de eliminación
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private CompanyDetail? companyToDelete = null;
    private int companyToDeleteOperationsCount = 0;
    private int companyToDeleteBankMovementsCount = 0;
    private int companyToDeleteDividendsCount = 0;

