    // Filtro por periodo de las tarjetas (SPEC-01-09): por defecto Total histórico (las tarjetas de hoy); no se recuerda
    private SalesPeriodFilter periodFilter = SalesPeriodFilter.All;
    private PeriodSummaryView periodView = PeriodSummaryView.Purchases;
    private PeriodSummary? periodSummary;
    private bool isLoadingPeriod;
    private string? periodError;
    private CancellationTokenSource? periodCts;
    private static readonly (SalesPeriodMode Mode, string Text)[] periodModes =
    {
        (SalesPeriodMode.Day, "Día"),
        (SalesPeriodMode.Month, "Mes"),
        (SalesPeriodMode.Year, "Año"),
        (SalesPeriodMode.All, "Total histórico")
    };
    private static readonly (PeriodSummaryView View, string Text)[] periodViews =
    {
        (PeriodSummaryView.Purchases, "Compras del periodo"),
        (PeriodSummaryView.Closing, "Cartera al cierre")
    };

    // Lo que pintan las tarjetas: el periodo elegido o, en Total histórico, las empresas con inversión de hoy
    private ConvertedCompanyTotals CardTotals => periodSummary?.Totals ?? investedTotals;
    private List<CompanyDetail> CardCompanies => periodSummary?.Companies ?? investedCompanies;
    private int CardSectorsCount => CardCompanies.Select(c => c.Sector).Distinct().Count();
    private decimal? CardDividendYield => InvestedCompaniesSummary.AverageDividendYield(CardCompanies);
    private decimal? CardReturn => InvestedCompaniesSummary.WeightedReturnPercent(CardTotals);
    private decimal? CardReturnWithDividends => InvestedCompaniesSummary.WeightedReturnWithDividendsPercent(CardTotals);
    private decimal? CardResult => InvestedCompaniesSummary.UnrealizedResult(CardTotals);
    private decimal CardDividends => periodSummary != null && periodView == PeriodSummaryView.Purchases
        ? periodSummary.PeriodDividends
        : CardTotals.Dividends;
    private string CardDividendsText => periodSummary == null
        ? "en dividendos"
        : periodView == PeriodSummaryView.Purchases
            ? "en dividendos cobrados en el periodo"
            : "en dividendos cobrados hasta esa fecha";
    private string ValueLabel => periodSummary?.CutoffDate is DateTime cutoff ? $"Valor al {cutoff:dd/MM/yyyy}" : "Valor actual";

    private string PeriodExplanation => periodView == PeriodSummaryView.Purchases
        ? $"Compras y traspasos de {PeriodPhrase} que sigues teniendo, valorados hoy con el tipo de cambio actual."
        : $"Tu cartera tal como estaba al cierre de {PeriodPhrase}, con los precios y el tipo de cambio de esa fecha.";

    private string PeriodPhrase => periodFilter.Mode switch
    {
        SalesPeriodMode.Day => $"el {periodFilter.Reference:dd/MM/yyyy}",
        SalesPeriodMode.Month => periodFilter.Label.ToLower(CultureInfo.GetCultureInfo("es-ES")),
        SalesPeriodMode.Year => periodFilter.Reference.Year.ToString(CultureInfo.InvariantCulture),
        _ => string.Empty
    };

    private Task SetPeriodMode(SalesPeriodMode mode) => ApplyPeriodAsync(periodFilter.WithMode(mode), periodView);

    private Task SetPeriodView(PeriodSummaryView view) => ApplyPeriodAsync(periodFilter, view);

    private Task PreviousPeriod() => ApplyPeriodAsync(periodFilter.Previous(), periodView);

    private Task NextPeriod() => ApplyPeriodAsync(periodFilter.Next(), periodView);

    private async Task OnPeriodDayChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
        {
            await ApplyPeriodAsync(SalesPeriodFilter.Create(SalesPeriodMode.Day, day), periodView);
        }
        else
        {
            periodError = "Indica un día válido.";
        }
    }

    private async Task OnPeriodMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            await ApplyPeriodAsync(SalesPeriodFilter.Create(SalesPeriodMode.Month, month), periodView);
        }
        else
        {
            periodError = "Indica un mes válido.";
        }
    }

    private async Task OnPeriodYearChanged(ChangeEventArgs e)
    {
        var yearFilter = int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var year)
            ? SalesPeriodFilter.TryCreateYear(year)
            : null;
        if (yearFilter != null)
        {
            await ApplyPeriodAsync(yearFilter, periodView);
        }
        else
        {
            periodError = $"Indica un año entre {SalesPeriodFilter.MinYear} y {SalesPeriodFilter.MaxYear}.";
        }
    }

    /// <summary>
    /// Recalcula las tarjetas para el periodo y la vista (SPEC-01-09). Total histórico vuelve a las de hoy.
    /// </summary>
    private async Task ApplyPeriodAsync(SalesPeriodFilter filter, PeriodSummaryView view)
    {
        periodFilter = filter;
        periodView = view;
        periodError = null;
        periodCts?.Cancel();

        if (filter.Mode == SalesPeriodMode.All)
        {
            periodSummary = null;
            return;
        }

        var cts = new CancellationTokenSource();
        periodCts = cts;
        isLoadingPeriod = true;
        try
        {
            var summary = view == PeriodSummaryView.Purchases
                ? await PortfolioPeriodService.GetPurchasesSummaryAsync(filter)
                : await PortfolioPeriodService.GetClosingSummaryAsync(filter, cts.Token);

            // Si mientras tanto se eligió otro periodo, este resultado ya no vale
            if (periodCts == cts)
            {
                periodSummary = summary;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            periodSummary = null;
            periodError = $"No se pudieron calcular las cifras del periodo: {ex.Message}";
        }
        finally
        {
            if (periodCts == cts)
            {
                isLoadingPeriod = false;
            }
        }
    }

    // Verde si es ≥ 0, rojo si es negativo y gris sin dato
    private static string SignSwatch(decimal? value) => value.HasValue ? (value.Value >= 0 ? "var(--gain)" : "var(--loss)") : "var(--ink-soft)";
