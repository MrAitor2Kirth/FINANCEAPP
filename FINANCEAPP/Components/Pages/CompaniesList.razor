    private CompanyDetail RealCompany(CompanyDetail company) => companies?.FirstOrDefault(c => c.Id == company.Id) ?? company;

    private string PeriodListText => periodView == PeriodSummaryView.Purchases
        ? $"con compras en {periodFilter.Label}"
        : periodSummary?.CutoffDate is DateTime cutoff ? $"con acciones el {cutoff:dd/MM/yyyy}" : "con acciones en el periodo";
    private int uniqueSectorsCount => investedCompanies.Select(c => c.Sector).Distinct().Count();
    private decimal? averageDividendYield => InvestedCompaniesSummary.AverageDividendYield(investedCompanies);
    private decimal? weightedReturn => InvestedCompaniesSummary.WeightedReturnPercent(investedTotals);
