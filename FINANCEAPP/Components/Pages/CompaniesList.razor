    private CompanyChartModal? chartModal;

    // Métricas calculadas
    // Las tarjetas de empresas, sectores, yield y rentabilidad solo cuentan las empresas con inversión (SPEC-01-05)
    private List<CompanyDetail> investedCompanies = new();
    private ConvertedCompanyTotals investedTotals = new();
    private Dictionary<int, decimal> weights = new();
