@page "/banco"
@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject IBankService BankService
@inject NavigationManager Navigation
@inject ILogger<BankAccountsList> Logger

<PageTitle>Cuentas Bancarias</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="sw" style="--swatch:var(--sage)">Gestión de Cuentas Bancarias</h1>
            <p class="text-muted">Administra tus cuentas bancarias y realiza seguimiento de movimientos</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span> Cargando cuentas...
        </div>
    }
    else if (bankAccounts == null || bankAccounts.Count == 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i> No hay cuentas bancarias registradas
            <button class="btn btn-primary ms-3" @onclick="NavigateToNewAccount">
                Crear primera cuenta
            </button>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-12">
                <button class="btn btn-primary" @onclick="NavigateToNewAccount">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nueva Cuenta
                </button>
                @* Traspaso entre cuentas (SPEC-10-02): hacen falta al menos dos *@
                @if (bankAccounts.Count >= 2)
                {
                    <button class="btn btn-outline-primary ms-2" @onclick="ToggleTransferForm">
                        <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i> Traspaso
                    </button>
                }
            </div>
        </div>

        @if (showTransferForm && bankAccounts.Count >= 2)
        {
            <BankTransferForm Accounts="@bankAccounts" OnTransferred="@OnTransferred" OnCancel="@ToggleTransferForm" />
        }

        <div class="stat-grid">
            <div class="stat-card" style="--swatch:var(--sage)">
                <p class="stat-label">Saldo total</p>
                <p class="stat-value @(totalBalance >= 0 ? "" : "text-danger")">@totalBalance.ToString("C")</p>
            </div>
            <div class="stat-card" style="--swatch:var(--teal)">
                <p class="stat-label">Cuentas activas</p>
                <p class="stat-value">@bankAccounts.Count</p>
            </div>
            <div class="stat-card" style="--swatch:var(--indigo)">
                <p class="stat-label">Promedio por cuenta</p>
                <p class="stat-value">@(bankAccounts.Count > 0 ? (totalBalance / bankAccounts.Count).ToString("C") : "N/A")</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre Cuenta</th>
                        <th>Banco</th>
                        <th>IBAN</th>
                        <th>Tipo</th>
                        <th>Saldo Actual</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in bankAccounts)
                    {
                        <tr>
                            <td>
                                <strong>@account.Name</strong>
                            </td>
                            <td>@account.BankName</td>
                            <td>
                                <code>@(MaskIban(account.IBAN))</code>
                            </td>
                            <td>@account.AccountType</td>
                            <td class="text-end">
                                <strong class="@(account.CurrentBalance >= 0 ? "text-success" : "text-danger")">
                                    @account.FormattedBalance
                                </strong>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToDetail(account.Id)">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => NavigateToEdit(account.Id)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAccount(account.Id)">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>

                        @if (expandedAccountId == account.Id)
                        {
                            <tr class="table-secondary">
                                <td colspan="6">
                                    <div class="p-3">
                                        <h6 class="mb-3">Últimas Operaciones</h6>
                                        <BankOperationsList @key="@($"{account.Id}-{refreshVersion}")" AccountName="@account.Name" BankService="@BankService" OnOperationAdded="@RefreshAccounts" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<BankAccount> bankAccounts = new();
    private bool isLoading = true;
    private int? expandedAccountId = null;
    private decimal totalBalance = 0;

    // Traspasos entre cuentas (SPEC-10-02): formulario y recarga de los movimientos desplegados
    private bool showTransferForm = false;
    private int refreshVersion = 0;

    private void ToggleTransferForm()
    {
        showTransferForm = !showTransferForm;
    }

    private async Task OnTransferred()
    {
        refreshVersion++;
        await RefreshAccounts();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAccounts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar cuentas");
        }
    }

    private async Task RefreshAccounts()
    {
        // El spinner solo se ve en la primera carga: así un refresco no cierra el desplegable de movimientos
        isLoading = bankAccounts.Count == 0;
        try
        {
            bankAccounts = await BankService.GetAllBankAccountsAsync();
            totalBalance = bankAccounts.Sum(a => a.CurrentBalance);
            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al refrescar cuentas");
            isLoading = false;
        }
    }

    private void NavigateToDetail(int accountId)
    {
        if (expandedAccountId == accountId)
        {
            expandedAccountId = null;
        }
        else
        {
            expandedAccountId = accountId;
        }
    }

    private void NavigateToEdit(int accountId)
    {
        Navigation.NavigateTo($"/banco/editar/{accountId}");
    }

    private void NavigateToNewAccount()
    {
        Navigation.NavigateTo("/banco/nueva");
    }

    private async Task DeleteAccount(int accountId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro? Se eliminarán todas sus operaciones."))
        {
            try
            {
                await BankService.DeleteBankAccountAsync(accountId);
                await RefreshAccounts();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error al eliminar cuenta");
            }
        }
    }

    private string MaskIban(string iban)
    {
        if (string.IsNullOrEmpty(iban) || iban.Length < 8)
            return iban;
        return $"****{iban.Substring(iban.Length - 4)}";
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}
