@using FINANCEAPP.Models
@using FINANCEAPP.Services
@using Microsoft.Extensions.Logging
@inject ILogger<BankOperationsList> Logger

@if (operations == null)
{
    <div class="alert alert-info">Cargando operaciones...</div>
}
else if (operations.Count == 0)
{
    <div class="alert alert-warning">No hay operaciones registradas</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var op in operations.OrderByDescending(x => x.Date))
                {
                    <tr class="@GetOperationRowClass(op.Type)">
                        <td>
                            <span class="badge @GetOperationBadgeClass(op.Type)">@op.Type</span>
                        </td>
                        <td class="text-end fw-bold">@op.Amount.ToString("C")</td>
                        <td>@op.Description</td>
                        <td>@op.Date.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOperation(op.Id)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <h6>Nueva Operación</h6>
    <div class="row g-2">
        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="newOperation.Type">
                <option value="">Seleccionar tipo...</option>
                <option value="Ingreso">Ingreso</option>
                <option value="Gasto">Gasto</option>
                <option value="Intereses">Intereses</option>
                <option value="Comisiones">Comisiones</option>
                <option value="Traspaso Entrada">Traspaso Entrada</option>
                <option value="Traspaso Salida">Traspaso Salida</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="number" class="form-control form-control-sm" placeholder="Cantidad" 
                   @bind="newOperation.Amount" step="0.01" />
        </div>
        <div class="col-md-3">
            <input type="date" class="form-control form-control-sm" @bind="newOperation.Date" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary w-100" @onclick="AddOperation">Añadir</button>
        </div>
    </div>
    <div class="row g-2 mt-2">
        <div class="col-12">
            <input type="text" class="form-control form-control-sm" placeholder="Descripción (opcional)" 
                   @bind="newOperation.Description" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string AccountName { get; set; }

    [Parameter]
    public IBankService BankService { get; set; }

    [Parameter]
    public EventCallback OnOperationAdded { get; set; }

    private List<BankOperation> operations = new();
    private BankOperation newOperation = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOperations();
    }

    private async Task LoadOperations()
    {
        try
        {
            operations = await BankService.GetOperationsByAccountNameAsync(AccountName);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando operaciones");
        }
    }

    private async Task AddOperation()
    {
        if (string.IsNullOrEmpty(newOperation.Type) || newOperation.Amount <= 0)
        {
            return;
        }

        try
        {
            newOperation.AccountName = AccountName;
            await BankService.CreateOperationAsync(newOperation);
            newOperation = new();
            await LoadOperations();
            await OnOperationAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error añadiendo operación");
        }
    }

    private async Task DeleteOperation(int operationId)
    {
        try
        {
            await BankService.DeleteOperationAsync(operationId);
            await LoadOperations();
            await OnOperationAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error eliminando operación");
        }
    }

    private string GetOperationBadgeClass(string type)
    {
        return type switch
        {
            "Ingreso" => "bg-success",
            "Intereses" => "bg-success",
            "Traspaso Entrada" => "bg-info",
            "Gasto" => "bg-danger",
            "Comisiones" => "bg-danger",
            "Traspaso Salida" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetOperationRowClass(string type)
    {
        return type switch
        {
            "Ingreso" or "Intereses" or "Traspaso Entrada" => "table-success",
            "Gasto" or "Comisiones" or "Traspaso Salida" => "table-danger",
            _ => ""
        };
    }
}
